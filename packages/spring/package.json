{
  "name": "@octanejs/spring",
  "version": "0.0.16",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "React Spring web bindings for Octane.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/spring"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "LICENSE.upstream",
    "README.md",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./parallax": "./src/parallax.ts"
  },
  "scripts": {
    "test": "pnpm upstream:verify && vitest run --project spring",
    "upstream:verify": "node ../../scripts/react-parity/react-spring-upstream.mjs",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsgo --noEmit -p typetests/tsconfig.json"
  },
  "dependencies": {
    "@react-spring/rafz": "10.1.2"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@react-spring/animated": "10.1.2",
    "@react-spring/core": "10.1.2",
    "@react-spring/mock-raf": "1.1.1",
    "@react-spring/parallax": "10.1.2",
    "@react-spring/shared": "10.1.2",
    "@react-spring/types": "10.1.2",
    "@react-spring/web": "catalog:default",
    "@types/react": "^19.2.17",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "4.1.10",
    "flush-microtasks": "1.0.1",
    "octane": "workspace:*",
    "playwright": "catalog:default",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "spec.ts": "^1.1.3",
    "vite": "catalog:default",
    "vitest": "catalog:default",
    "vitest-browser-react": "^2.2.0"
  }
}
