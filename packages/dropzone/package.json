{
  "name": "@octanejs/dropzone",
  "version": "0.0.16",
  "description": "The exact react-dropzone 20.0.0 file-acquisition contract, ported to Octane with drag, click, paste, validation, async processing, and programmatic-open support.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/dropzone"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.2"
  },
  "main": "./src/index.tsrx",
  "module": "./src/index.tsrx",
  "types": "./src/index.tsrx",
  "exports": {
    ".": {
      "types": "./src/index.tsrx",
      "import": "./src/index.tsrx",
      "require": "./src/index.tsrx"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE",
    "LICENSE.upstream"
  ],
  "scripts": {
    "test": "pnpm upstream:verify && pnpm test:u2-parity && pnpm test:u3-parity && pnpm test:u4-parity && pnpm test:u5-parity && pnpm test:adoption && pnpm test:packed",
    "test:adoption": "node --test tests/adoption/*.test.mjs",
    "upstream:verify": "node audit/verify-provenance.mjs",
    "test:packed": "node tests/probes/packed-exports.test.mjs",
    "test:u2-parity": "node audit/verify-u2.mjs",
    "test:u3-parity": "node audit/verify-u3.mjs",
    "test:u4-parity": "node audit/verify-u4.mjs",
    "test:u5-parity": "node ../../scripts/react-parity/harness.mjs validate --manifest packages/dropzone/audit/react-parity.json && node --test ../../scripts/react-parity/react-dropzone-evidence.test.mjs",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.json"
  },
  "dependencies": {
    "attr-accept": "^2.2.5",
    "file-selector": "^4.1.0"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@types/react": "19.2.11",
    "@types/react-dom": "19.2.3",
    "octane": "workspace:*",
    "playwright": "catalog:default",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "catalog:default",
    "vite": "catalog:default"
  }
}
