      "id": "react-resizable-panels-useId-fallback",
      "caseIds": ["runtime:react-resizable-panels:0415"],
      "upstreamResult": "With React.useId mocked to return ':r123:', useId(undefined) equals ':r123:'.",
      "octaneResult": "Octane's useId fallback returns a non-empty framework-owned id string; the adapted case cannot reproduce React's mock.",
      "rationale": "Octane does not expose React's useId mock seam; the fallback identity is an N-A framework boundary, not an equivalent upstream assertion.",
      "classification": "framework-contract",
      "consumerImpact": "Callers that relied on React's mocked ':r123:' test seam need Octane-specific id expectations.",
      "migrationGuidance": "Assert non-empty string (or an explicit id) rather than React's mocked ':r123:' when testing useId(undefined).",
      "owner": "@octanejs/resizable-panels",
      "reviewCondition": "Review if Octane gains a React-compatible useId mock seam or if upstream stops asserting mocked React.useId output."
    }
