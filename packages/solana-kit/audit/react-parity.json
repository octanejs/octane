  "divergences": [
    {
      "id": "solana-kit-missing-provider-error",
      "caseIds": ["runtime:32e73d9952587b2f", "runtime:d775c531b3e8370b"],
      "upstreamResult": "useClient throws SolanaError MISSING_PROVIDER with hookName context.",
      "octaneResult": "useClient throws a plain Error with message 'useClient must be used inside ClientProvider'.",
      "rationale": "The Octane binding keeps the public failure surface free of @solana/kit React error codes while preserving the must-be-under-provider contract.",
      "classification": "error-model",
      "consumerImpact": "Catch sites that match SolanaError codes must match the Error message instead.",
      "migrationGuidance": "Prefer try/catch on the message or a shared helper rather than SOLANA_ERROR__REACT__MISSING_PROVIDER.",
      "owner": "@octanejs/solana-kit",
      "reviewCondition": "Review if Octane adopts SolanaError for binding-boundary failures."
    },
    {
      "id": "solana-kit-capability-error",
      "caseIds": [
        "runtime:f55bf79ffdd7ffe2",
        "runtime:697b90de86fb3bd4",
        "runtime:5f370d960e375ce4"
      ],
      "upstreamResult": "useClientCapability throws SolanaError MISSING_CAPABILITY listing every missing capability.",
      "octaneResult": "useClientCapability throws a plain Error naming the first missing capability in the configured list.",
      "rationale": "Octane validates capabilities sequentially and surfaces a single actionable message without importing SolanaError into the public binding.",
      "classification": "error-model",
      "consumerImpact": "Callers that inspected SolanaError.context.capabilities see a message string instead.",
      "migrationGuidance": "Parse the Error message or check capabilities before calling the hook.",
      "owner": "@octanejs/solana-kit",
      "reviewCondition": "Review if the binding starts returning SolanaError for capability failures."
    },
    {
      "id": "solana-kit-sync-client-only",
      "caseIds": [
        "runtime:8dce5b0ab8f4ae0a",
        "runtime:14c8d6af4a82769f",
        "runtime:fb3f27ba06fcb68d"
      ],
      "upstreamResult": "ClientProvider accepts Promise<Client>, suspends while pending, and propagates rejection to the nearest error boundary.",
      "octaneResult": "ClientProvider accepts only a resolved client and throws if a thenable is passed.",
      "rationale": "Octane bindings keep async plugin setup outside the provider so Suspense is not required for client construction.",
      "classification": "api-surface",
      "consumerImpact": "Callers must await client construction before mounting ClientProvider.",
      "migrationGuidance": "Resolve the client Promise, then pass the settled client to ClientProvider.",
      "owner": "@octanejs/solana-kit",
      "reviewCondition": "Review if Octane gains a first-class async ClientProvider path."
    },
    {
      "id": "solana-kit-query-ssr",
      "caseIds": ["runtime:04e39c17fcc6fcd5"],
      "upstreamResult": "renderToString of useRequestQuery renders idle markup without firing queryFn.",
      "octaneResult": "QueryClientProvider SSR host plumbing may throw in this pin; the adapted identity still asserts queryFn is not invoked while effects are absent.",
      "rationale": "Preserve the no-fetch-during-SSR oracle without weakening it to a skipped case.",
      "classification": "environment",
      "consumerImpact": "Server render of request queries should not start network work before hydration effects.",
      "migrationGuidance": "Treat idle SSR/pre-effect as the contract; do not rely on React-specific QueryClientProvider SSR markup.",
      "owner": "@octanejs/solana-kit",
      "reviewCondition": "Review when @octanejs/tanstack-query SSR provider host parity lands."
    }
  ]
