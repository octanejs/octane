{
  "name": "@octanejs/octane-is",
  "version": "0.0.1",
  "description": "Element-kind predicates for Octane, matching react-is 19.2.7's public surface.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.2"
  },
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/octane-is"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE",
    "LICENSE.upstream"
  ],
  "scripts": {
    "test": "vitest run --root ../.. --project octane-is --project octane-is-pristine --project octane-is-differential --maxWorkers=2",
    "upstream:verify": "node ../../scripts/react-parity/verify-provenance.mjs",
    "upstream:test": "node ../../scripts/react-parity/run-pristine.mjs octane-is"
  },
  "peerDependencies": {
    "octane": "workspace:^0.1.51 || ^0.2.0"
  },
  "devDependencies": {
    "octane": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vitest": "catalog:default"
  }
}
