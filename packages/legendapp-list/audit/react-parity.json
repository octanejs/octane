  "divergences": [
    {
      "id": "dom-order",
      "caseIds": ["differential:legendapp-list-row-hooks", "differential:legendapp-list-picker"],
      "upstreamResult": "Upstream moves the row container elements with insertBefore 500ms after the last position change, so DOM order follows item order. React's tree keeps container-slot order, so sibling rows' effects keep running in slot order.",
      "octaneResult": "The port renders the containers in that same debounced item order through a keyed @for, so Octane moves the elements. DOM order matches; sibling rows run their effects in DOM order.",
      "rationale": "Octane tracks each component's DOM as a range between comment markers. An element moved behind its back leaves those ranges, and a later removal orphans it (the differential's stray-row check fails with upstream's mechanism).",
      "classification": "renderer-adaptation",
      "consumerImpact": "Row effects across different rows may run in a different order after a reorder. Each row’s own effects keep their order.",
      "migrationGuidance": "None.",
      "owner": "@octanejs/legendapp-list",
      "reviewCondition": "Review if Octane supports externally reordered keyed children."
    }
  ]
