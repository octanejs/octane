+// OCTANE DIVERGENCE[hook-form-dom-markers]: Compare the same public DOM snapshot
+// after omitting Octane's empty-hole and work-in-progress comment anchors.
+function publicFragment(fragment: DocumentFragment): DocumentFragment {
+  const clone = fragment.cloneNode(true) as DocumentFragment;
+  const walker = document.createTreeWalker(clone, NodeFilter.SHOW_COMMENT);
+  const markers: Node[] = [];
+  while (walker.nextNode()) {
+    if (['', 'wip', '/wip'].includes(walker.currentNode.nodeValue || '')) {
+      markers.push(walker.currentNode);
+    }
+  }
+  for (const marker of markers) marker.parentNode?.removeChild(marker);
+  return clone;
+}
