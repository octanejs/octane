{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://octanejs.dev/schemas/react-parity.schema.json",
  "title": "Bounded React parity evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "adaptedScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "include", "exclude"],
      "properties": {
        "roots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": { "properties": { "verification": { "const": "verified" } } },
          "upstreamSuites": {
            "properties": { "runtime": { "enum": ["present", "insufficient"] } }
          }
        },
        "required": ["provenance", "upstreamSuites"]
      },
      "then": {
        "properties": {
          "lanes": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "type": { "const": "pristine-upstream" },
                    "oracle": { "const": "required" },
                    "available": { "not": { "const": false } },
                    "evidenceOrigin": { "const": "upstream-suite" },
                    "execution": {
                      "properties": {
                        "kind": { "enum": ["vitest-full", "jest-full"] }
                      },
                      "required": ["kind"]
                    }
                  },
                  "required": ["type", "oracle", "evidenceOrigin", "execution"]
                }
              },
              {
                "contains": {
                  "properties": {
                    "type": { "const": "adapted-octane" },
                    "oracle": { "const": "required" },
                    "available": { "not": { "const": false } },
                    "evidenceOrigin": { "const": "upstream-suite" },
                    "execution": {
                      "properties": { "kind": { "const": "vitest-full" } },
                      "required": ["kind"]
                    }
                  },
                  "required": ["type", "oracle", "evidenceOrigin", "execution"]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": { "properties": { "verification": { "const": "verified" } } },
          "upstreamSuites": { "properties": { "runtime": { "const": "insufficient" } } }
        },
        "required": ["provenance", "upstreamSuites"]
      },
      "then": {
        "properties": {
          "lanes": {
            "contains": {
              "properties": {
                "type": { "const": "differential" },
                "oracle": { "const": "required" },
                "available": { "not": { "const": false } },
                "evidenceOrigin": { "const": "repo-authored" }
              },
              "required": ["type", "oracle", "evidenceOrigin"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": { "properties": { "verification": { "const": "verified" } } },
          "upstreamSuites": { "properties": { "runtime": { "const": "absent" } } }
        },
        "required": ["provenance", "upstreamSuites"]
      },
      "then": {
        "properties": {
          "lanes": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "type": { "const": "adapted-octane" },
                    "oracle": { "const": "required" },
                    "available": { "not": { "const": false } },
                    "evidenceOrigin": { "const": "repo-authored" },
                    "execution": {
                      "properties": { "kind": { "const": "vitest-full" } },
                      "required": ["kind"]
                    }
                  },
                  "required": ["type", "oracle", "evidenceOrigin", "execution"]
                }
              },
              {
                "contains": {
                  "properties": {
                    "type": { "const": "differential" },
                    "oracle": { "const": "required" },
                    "available": { "not": { "const": false } },
                    "evidenceOrigin": { "const": "repo-authored" }
                  },
                  "required": ["type", "oracle", "evidenceOrigin"]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": { "properties": { "verification": { "const": "verified" } } },
          "upstreamSuites": { "properties": { "types": { "const": "present" } } }
        },
        "required": ["provenance", "upstreamSuites"]
      },
      "then": {
        "properties": {
          "lanes": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "type": { "const": "pristine-types" },
                    "oracle": { "const": "required" },
                    "available": { "not": { "const": false } },
                    "evidenceOrigin": { "const": "upstream-suite" }
                  },
                  "required": ["type", "oracle", "evidenceOrigin"]
                }
              },
              {
                "contains": {
                  "properties": {
                    "type": { "const": "adapted-types" },
                    "oracle": { "const": "required" },
                    "available": { "not": { "const": false } },
                    "evidenceOrigin": { "const": "upstream-suite" }
                  },
                  "required": ["type", "oracle", "evidenceOrigin"]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provenance": { "properties": { "verification": { "const": "verified" } } },
          "upstreamSuites": {
            "properties": { "types": { "enum": ["absent", "insufficient"] } }
          }
        },
        "required": ["provenance", "upstreamSuites"]
      },
      "then": {
        "properties": {
          "lanes": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "type": { "const": "pristine-types" },
                    "oracle": { "const": "required" },
                    "available": { "not": { "const": false } },
                    "evidenceOrigin": { "const": "repo-authored" }
                  },
                  "required": ["type", "oracle", "evidenceOrigin"]
                }
              },
              {
                "contains": {
                  "properties": {
                    "type": { "const": "adapted-types" },
                    "oracle": { "const": "required" },
                    "available": { "not": { "const": false } },
                    "evidenceOrigin": { "const": "repo-authored" }
                  },
                  "required": ["type", "oracle", "evidenceOrigin"]
                }
              }
            ]
          }
        }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "provenance",
    "upstreamSuites",
    "adaptedRoots",
    "adaptedRuntimeSummary",
    "environments",
    "lanes",
    "divergences"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "$schema": { "type": "string" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "version",
        "commit",
        "sourceRoot",
        "testRoot",
        "license",
        "integrity",
        "verification"
      ],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceRoot": { "type": "string", "minLength": 1 },
        "testRoot": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "verification": { "enum": ["recorded-unverified", "verified"] }
      }
    },
    "upstreamSuites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "types"],
      "properties": {
        "runtime": { "enum": ["present", "absent", "insufficient"] },
        "types": { "enum": ["present", "absent", "insufficient"] }
      }
    },
    "adaptedRoots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "tests"],
      "properties": {
        "source": { "$ref": "#/$defs/adaptedScan" },
        "tests": { "$ref": "#/$defs/adaptedScan" }
      }
    },
    "adaptedRuntimeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryEntries",
        "uniqueIdentities",
        "duplicateEntriesWithinLanes",
        "identitiesSharedAcrossLanes"
      ],
      "properties": {
        "inventoryEntries": { "type": "integer", "minimum": 0 },
        "uniqueIdentities": { "type": "integer", "minimum": 0 },
        "duplicateEntriesWithinLanes": { "type": "integer", "minimum": 0 },
        "identitiesSharedAcrossLanes": { "type": "integer", "minimum": 0 }
      }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "platform", "arch", "packageManager", "lockfile", "lockfileSha256"],
        "properties": {
          "node": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "arch": { "type": "string", "minLength": 1 },
          "packageManager": { "type": "string", "minLength": 1 },
          "lockfile": { "type": "string", "minLength": 1 },
          "lockfileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "adapted-types" } },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "execution": {
                  "properties": { "compiler": { "const": "tsrx-tsc" } },
                  "required": ["compiler"]
                }
              },
              "required": ["execution"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "pristine-types" } },
              "required": ["type"]
            },
            "then": {
              "properties": {
                "execution": {
                  "properties": { "compiler": { "const": "tsc" } },
                  "required": ["compiler"]
                }
              },
              "required": ["execution", "evidenceOrigin"]
            }
          },
          {
            "if": {
              "properties": {
                "type": { "enum": ["pristine-types", "adapted-types"] }
              },
              "required": ["type"]
            },
            "then": { "required": ["evidenceOrigin"] }
          },
          {
            "if": {
              "properties": {
                "type": { "enum": ["pristine-upstream", "adapted-octane"] },
                "execution": {
                  "properties": { "kind": { "enum": ["vitest-full", "jest-full"] } },
                  "required": ["kind"]
                }
              },
              "required": ["type", "execution"]
            },
            "then": { "required": ["evidenceOrigin"] }
          },
          {
            "if": {
              "properties": { "type": { "const": "differential" } },
              "required": ["type", "evidenceOrigin"]
            },
            "then": { "properties": { "evidenceOrigin": { "const": "repo-authored" } } }
          },
          {
            "if": { "required": ["evidenceOrigin"] },
            "then": {
              "anyOf": [
                {
                  "properties": {
                    "type": { "enum": ["pristine-types", "adapted-types"] }
                  },
                  "required": ["type"]
                },
                {
                  "properties": {
                    "type": { "enum": ["pristine-upstream", "adapted-octane"] },
                    "execution": {
                      "properties": { "kind": { "enum": ["vitest-full", "jest-full"] } },
                      "required": ["kind"]
                    }
                  },
                  "required": ["type", "execution"]
                },
                {
                  "properties": { "type": { "const": "differential" } },
                  "required": ["type"]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "execution": {
                  "properties": { "kind": { "const": "jest-full" } },
                  "required": ["kind"]
                }
              },
              "required": ["execution"]
            },
            "then": {
              "properties": { "type": { "const": "pristine-upstream" } },
              "required": ["type"]
            }
          }
        ],
        "required": ["id", "type", "oracle", "environment", "project", "files"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "enum": [
              "pristine-upstream",
              "adapted-octane",
              "differential",
              "browser",
              "pristine-types",
              "adapted-types"
            ]
          },
          "oracle": { "enum": ["required", "optional"] },
          "available": { "type": "boolean" },
          "environment": { "type": "string", "minLength": 1 },
          "project": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" },
          "evidenceOrigin": { "enum": ["upstream-suite", "repo-authored"] },
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "oneOf": [
              {
                "properties": { "kind": { "const": "typescript" } },
                "required": ["kind", "compiler", "project"],
                "not": {
                  "anyOf": [
                    { "required": ["inventory"] },
                    { "required": ["config"] },
                    { "required": ["root"] }
                  ]
                }
              },
              {
                "properties": { "kind": { "const": "vitest-full" } },
                "required": ["kind", "inventory"],
                "not": {
                  "anyOf": [
                    { "required": ["compiler"] },
                    { "required": ["project"] },
                    { "required": ["config"] },
                    { "required": ["root"] }
                  ]
                }
              },
              {
                "properties": { "kind": { "const": "jest-full" } },
                "required": ["kind", "config", "root", "inventory"],
                "not": {
                  "anyOf": [{ "required": ["compiler"] }, { "required": ["project"] }]
                }
              }
            ],
            "properties": {
              "kind": { "enum": ["typescript", "vitest-full", "jest-full"] },
              "compiler": { "enum": ["tsc", "tsgo", "tsrx-tsc"] },
              "project": { "type": "string", "minLength": 1 },
              "inventory": { "type": "string", "minLength": 1 },
              "config": { "type": "string", "minLength": 1 },
              "root": { "type": "string", "minLength": 1 }
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "role", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "role": { "enum": ["test", "support"] },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "cases": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "testName", "fullName"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "testName": { "type": "string", "minLength": 1 },
                      "fullName": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "divergences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "caseIds",
          "upstreamResult",
          "octaneResult",
          "rationale",
          "classification",
          "consumerImpact",
          "migrationGuidance",
          "owner",
          "reviewCondition"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "caseIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "upstreamResult": { "type": "string", "minLength": 1 },
          "octaneResult": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "classification": { "type": "string", "minLength": 1 },
          "consumerImpact": { "type": "string", "minLength": 1 },
          "migrationGuidance": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reviewCondition": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
