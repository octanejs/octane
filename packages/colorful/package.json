{
  "name": "@octanejs/colorful",
  "version": "0.0.16",
  "description": "Exact Octane binding for react-colorful 5.8.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/colorful"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "LICENSE",
    "LICENSE.upstream",
    "README.md",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "pnpm upstream:verify && pnpm typecheck && vitest run --root ../.. --project colorful --project colorful-upstream --project colorful-ssr --project colorful-hydration --project colorful-differential",
    "upstream:verify": "node audit/upstream-inventory.mjs",
    "test:type-parity": "node ../../scripts/react-parity/react-colorful-types.mjs",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.adapted.json && tsc --noEmit -p typetests/tsconfig.pristine.json && tsc --noEmit -p audit/type-probes/tsconfig.pristine.json",
    "test:pristine": "node ../../scripts/react-parity/jest-full-runner.mjs --config packages/colorful/tests/upstream-jest.config.cjs --root packages/colorful/upstream"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@tsrx/react": "catalog:default",
    "@types/react": "catalog:react-colorful-react-oracle",
    "@types/react-dom": "catalog:react-colorful-react-oracle",
    "octane": "workspace:*",
    "playwright": "catalog:default",
    "react": "catalog:react-colorful-react-oracle",
    "react-colorful": "5.8.0",
    "react-dom": "catalog:react-colorful-react-oracle",
    "vite": "catalog:default",
    "vitest": "catalog:default",
    "@testing-library/react": "16.3.2",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "@swc/jest": "0.2.39",
    "@swc/core": "1.15.41",
    "@types/react-colorful-pristine": "npm:@types/react@17.0.83",
    "@types/react-dom-colorful-pristine": "npm:@types/react-dom@17.0.26"
  }
}
