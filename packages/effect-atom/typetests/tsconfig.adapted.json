{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "es2022",
    "strict": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "types": []
  },
  "include": ["./adapted"],
  "reactPortEvidence": {
    "gate": "upstream-types-adapted",
    "upstreamRegistrations": []
  }
}
