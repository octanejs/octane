{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "es2022",
    "strict": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [],
    "paths": {
      "@effect/atom-react": ["../upstream/src/index.ts"]
    }
  },
  "include": ["./pristine"],
  "reactPortEvidence": {
    "gate": "upstream-types-pristine",
    "upstreamRegistrations": []
  }
}
