{
  "name": "@octanejs/codemod",
  "version": "0.1.4",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "Migrate a React codebase to Octane: rewrite React + TSX/JSX modules as Octane + TSRX, optionally in Strong mode.",
  "license": "MIT",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/codemod"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "octane",
    "codemod",
    "migration",
    "react",
    "tsrx"
  ],
  "files": [
    "dist",
    "templates",
    "src/path-svg.ts",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "octane-codemod": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "octane-tsc -p tsconfig.typecheck.json",
    "prepare": "pnpm run build",
    "test": "cd ../.. && vitest run --project codemod"
  },
  "dependencies": {
    "@octanejs/cli": "workspace:*",
    "@tsrx/oxc": "catalog:default",
    "octane": "workspace:*",
    "picocolors": "catalog:default",
    "typescript": "catalog:default"
  },
  "devDependencies": {
    "clsx": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-intl": "7.1.14",
    "vitest": "catalog:default"
  }
}
