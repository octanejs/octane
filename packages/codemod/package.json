{
  "name": "@octanejs/codemod",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "Migrate a React codebase to Octane: rewrite React + TSX/JSX modules as Octane + TSRX, optionally in Strong mode.",
  "license": "MIT",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/codemod"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "octane",
    "codemod",
    "migration",
    "react",
    "tsrx"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "octane-codemod": "src/bin.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "cd ../.. && vitest run --project codemod"
  },
  "dependencies": {
    "@octanejs/cli": "workspace:*",
    "octane": "workspace:*",
    "picocolors": "catalog:default",
    "typescript": "catalog:default"
  },
  "devDependencies": {
    "vitest": "catalog:default"
  }
}
