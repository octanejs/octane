{
  "name": "@octanejs/gsap",
  "version": "0.0.19",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "GSAP lifecycle bindings for Octane — the useGSAP hook over the framework-agnostic GSAP core.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/gsap"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "UPSTREAM.md",
    "status.json"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project gsap --project gsap-ssr --project gsap-differential"
  },
  "peerDependencies": {
    "gsap": "^3.12.5",
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@gsap/react": "catalog:default",
    "@tsrx/react": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "esbuild": "catalog:default",
    "gsap": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vitest": "catalog:default"
  }
}
