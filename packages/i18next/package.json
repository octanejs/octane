{
  "name": "@octanejs/i18next",
  "version": "0.1.47",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "react-i18next for the octane renderer — reuses i18next unchanged and ports the React context, hooks, Trans, ICU, and SSR binding layer onto octane.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/i18next"
  },
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "status.json",
    "LICENSE",
    "LICENSE.upstream"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./TransWithoutContext": {
      "types": "./src/TransWithoutContext.d.ts",
      "default": "./src/TransWithoutContext.js"
    },
    "./initReactI18next": {
      "types": "./src/initReactI18next.d.ts",
      "default": "./src/initReactI18next.js"
    }
  },
  "scripts": {
    "test": "pnpm upstream:materialize && vitest run --root ../.. --project i18next --project i18next-differential --project i18next-ssr --project i18next-pristine-runtime && node ../../scripts/react-parity/harness.mjs run-required --manifest packages/i18next/audit/react-parity.json",
    "upstream:materialize": "node ../../scripts/react-port/materialize.mjs run --package-dir .",
    "upstream:verify": "node ../../scripts/react-parity/verify-provenance.mjs",
    "typecheck": "tsrx-tsc --noEmit"
  },
  "dependencies": {
    "html-parse-stringify": "catalog:default"
  },
  "peerDependencies": {
    "i18next": ">=26.2.0",
    "octane": "workspace:^0.1.51 || ^0.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:default",
    "@tsrx/react": "catalog:default",
    "esbuild": "catalog:default",
    "i18next": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-i18next": "catalog:default",
    "vitest": "catalog:default",
    "@babel/core": "catalog:default",
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "babel-plugin-macros": "3.1.0",
    "babel-plugin-tester": "11.0.4",
    "use-sync-external-store": "1.6.0"
  }
}
