      "upstreamResult": "React `Trans` inspects JSX children elements directly and `Translation` passes its render callback through the children position.",
      "octaneResult": "Octane `Trans` inspects explicit descriptor children and `Translation` receives its render callback as a prop.",
      "rationale": "Octane compiles JSX to descriptors ahead of time; children are descriptor objects rather than React elements, so child inspection reads the compiled shape.",
      "classification": "react-to-octane-element-model",
      "consumerImpact": "Public `Trans`/`Translation` behavior is preserved; only the internal child-inspection shape differs.",
      "migrationGuidance": "None required for consumers; descriptor children are the authored Octane contract.",
      "owner": "@octanejs/i18next",
      "reviewCondition": "Review if Octane element descriptors change shape or expose a React-compatible element view."
    },
