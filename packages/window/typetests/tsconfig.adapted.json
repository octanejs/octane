{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": false,
    "noEmit": true,
    "noErrorTruncation": true,
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "baseUrl": ".",
