{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "noEmit": true,
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noErrorTruncation": false,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": false,
    "types": ["node"],
    "strict": true
  },
  "include": ["./src/", "./tests/types/"],
  "exclude": ["node_modules", "dist", "upstream"],
  "reactPortEvidence": {
    "gate": "authored-source-types"
  }
}
