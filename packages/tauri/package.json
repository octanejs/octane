{
  "name": "@octanejs/tauri",
  "version": "0.0.7",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "Tauri bindings for the octane renderer — Octane hooks over the framework-neutral @tauri-apps/api command and event surface.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/tauri"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tauri-apps/api": ">=2.0.0",
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/api": "catalog:default",
    "octane": "workspace:*",
    "vitest": "catalog:default"
  }
