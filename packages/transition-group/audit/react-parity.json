		{
			"id": "react-transition-group-no-strict-double-appear",
			"caseIds": [
				"runtime:8b31bf604e15e535"
			],
			"upstreamResult": "Under React 18 StrictEffects, appear/enter callbacks fire twice (`['appear','appear','appearing','appeared']` / `['enter','enter','entering','entered']`).",
			"octaneResult": "Octane does not double-invoke; adapted coverage asserts the single-invoke sequence (`['appear','appearing','appeared']` / `['enter','entering','entered']`).",
			"rationale": "Octane deliberately has no StrictMode double-invoke. Exact adapted parity cannot claim the React 18 strict-render branch.",
			"classification": "lifecycle-model",
			"consumerImpact": "Appear/enter side effects run once on mount/update, not twice under a StrictMode-like double render.",
			"migrationGuidance": "Do not rely on StrictMode double-invocation of transition appear/enter callbacks when porting from React 18.",
			"owner": "@octanejs/transition-group",
			"reviewCondition": "Review if Octane adds a StrictMode double-invoke mode for development."
		}
	]
