{
  "name": "@octanejs/tanstack-virtual",
  "version": "0.1.49",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "TanStack Virtual bindings for the octane renderer \u2014 reuses the framework-agnostic @tanstack/virtual-core and swaps the React adapter (useVirtualizer, useWindowVirtualizer) for an octane port.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/tanstack-virtual"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE.upstream"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project tanstack-virtual --project tanstack-virtual-adapted --project tanstack-virtual-differential --project tanstack-virtual-ssr"
  },
  "dependencies": {
    "@tanstack/virtual-core": "3.17.10"
  },
  "peerDependencies": {
    "octane": "workspace:^0.1.51 || ^0.2.0"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "3.14.12",
    "@tsrx/react": "catalog:default",
    "esbuild": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vitest": "catalog:default",
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/react": "catalog:default",
    "@testing-library/jest-dom": "catalog:default",
    "@babel/core": "catalog:default",
    "babel-plugin-react-compiler": "catalog:default",
    "@playwright/test": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "resize-observer-polyfill": "1.5.1",
    "vite": "catalog:default"
  }
}
