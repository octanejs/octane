  "divergences": [
    {
      "id": "intersection-observer-initial-false-onchange",
      "caseIds": ["runtime:87f04d520e6196ac", "runtime:96c5c288913a844e"],
      "upstreamResult": "React class InView often observes twice, so an unsupported false fallback can still reach onChange after the initial-false gate.",
      "octaneResult": "Octane observes once, so the documented initial-false skip suppresses onChange for unsupported false fallback.",
      "rationale": "Both runtimes ignore the first false notification; React double-observe accidentally clears the gate.",
      "classification": "testing-runtime",
      "consumerImpact": "Unsupported false fallback does not emit an onChange(false) on mount under Octane.",
      "migrationGuidance": "Treat unsupported false as the default hidden state rather than waiting for an onChange(false).",
      "owner": "@octanejs/intersection-observer",
      "reviewCondition": "Review if Octane InView gains a class-component-equivalent observe lifecycle."
    },
    {
      "id": "intersection-observer-unsupported-mount-error-surface",
      "caseIds": ["runtime:4ded56f226061c62", "runtime:c0bb0181b9e6cedf"],
      "upstreamResult": "Mounting InView/useInView without a fallback throws synchronously when IntersectionObserver is missing.",
      "octaneResult": "Observation runs in a passive effect, so the same constructor error is reported via console.error/tryBlock after commit. The adapted InView fallback cases exercise the same public-API surface alongside intersection-observer-initial-false-onchange.",
      "rationale": "Octane has no class-component componentDidMount observe path; useInView always observes from useEffect.",
      "classification": "framework-runtime",
      "consumerImpact": "try/catch around render does not catch unsupported IntersectionObserver errors under Octane.",
      "migrationGuidance": "Supply fallbackInView/defaultFallbackInView, or catch with tryBlock/an error boundary around the observing tree.",
      "owner": "@octanejs/intersection-observer",
      "reviewCondition": "Review if Octane gains a synchronous observe-on-mount path for unsupported environments."
    }
  ]
