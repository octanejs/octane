{
  "name": "@octanejs/intersection-observer",
  "version": "0.0.16",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "react-intersection-observer for Octane.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/intersection-observer"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "status.json",
    "LICENSE.upstream"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./test-utils": "./src/test-utils.ts"
  },
  "scripts": {
    "test": "pnpm upstream:materialize && vitest run --root ../.. --config vitest.config.js --project intersection-observer",
    "typecheck": "tsrx-tsc --noEmit",
    "upstream:materialize": "node ../../scripts/react-port/materialize.mjs run --package-dir .",
    "upstream:verify": "node ../../scripts/react-port/materialize.mjs run --check --package-dir ."
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "@vitest/browser-playwright": "4.1.10",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-intersection-observer": "10.1.0",
    "vitest": "catalog:default"
  }
}
