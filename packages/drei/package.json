{
  "name": "@octanejs/drei",
  "version": "0.0.16",
  "description": "Octane port of @react-three/drei",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts",
    "./core": "./src/core/index.ts",
    "./config": "./src/config.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE",
    "LICENSE.upstream",
    "status.json"
  ],
  "scripts": {
    "upstream:generate": "node scripts/generate-upstream-crosswalk.mjs",
    "upstream:check": "node scripts/check-upstream-crosswalk.mjs",
    "upstream:ready": "node scripts/check-upstream-crosswalk.mjs --ready",
    "react-parity:generate": "node scripts/generate-react-parity.mjs",
    "react-parity:check": "node scripts/check-react-parity.mjs",
    "test": "node scripts/check-react-parity.mjs && vitest run --root ../.. --project drei-differential --project drei-guards --project drei-adapted-browser",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.17",
    "@monogrid/gainmap-js": "^3.0.6",
    "@octanejs/zustand": "workspace:*",
    "@use-gesture/core": "^10.3.1",
    "camera-controls": "^3.1.0",
    "detect-gpu": "^5.0.56",
    "hls.js": "^1.5.17",
    "maath": "^0.10.8",
    "meshline": "^3.3.1",
    "stats-gl": "^2.2.8",
    "stats.js": "^0.17.0",
    "three-mesh-bvh": "^0.8.3",
    "three-stdlib": "^2.35.6",
    "troika-three-text": "^0.52.4"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "peerDependencies": {
    "@octanejs/three": "workspace:*",
    "@types/three": ">=0.159",
    "octane": "workspace:*",
    "three": ">=0.159"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/drei"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "devDependencies": {
    "@octanejs/three": "workspace:*",
    "@octanejs/zustand": "workspace:*",
    "@react-three/drei": "catalog:default",
    "@react-three/fiber": "catalog:default",
    "@tsrx/react": "catalog:default",
    "@types/react": "catalog:default",
    "@types/stats.js": "^0.17.4",
    "@types/three": "catalog:default",
    "octane": "workspace:*",
    "playwright": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "three": "catalog:default",
    "typescript": "catalog:default",
    "vite": "catalog:default",
    "vitest": "catalog:default"
  }
}
