{
  "name": "@octanejs/thinking-orbs",
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "thinking-orbs for the octane renderer — dotted thought-orb loading indicators for AI and agent UIs.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/thinking-orbs"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "LICENSE.upstream",
    "UPSTREAM.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project thinking-orbs --project thinking-orbs-differential --project thinking-orbs-browser",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p tsconfig.public.json && tsrx-tsc --noEmit -p tsconfig.fixtures.json",
    "typecheck:pristine": "tsc --noEmit -p tsconfig.pristine.json",
    "upstream:verify": "node ../../scripts/react-port/materialize.mjs run --package-dir . --check"
  },
  "peerDependencies": {
    "octane": "workspace:^0.1.51 || ^0.2.0"
  },
  "devDependencies": {
    "@tsrx/react": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "esbuild": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vitest": "catalog:default"
  },
  "dependencies": {
    "thinking-orbs": "catalog:default"
  }
}
