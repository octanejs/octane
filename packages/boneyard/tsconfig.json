{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "noEmit": true,
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noErrorTruncation": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "octane"
  },
  "reactPortEvidence": {
    "gate": "authored-source-types"
  },
  "include": ["./src/"],
  "exclude": ["node_modules", "dist", "tests"]
}
