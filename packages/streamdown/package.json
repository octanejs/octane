{
  "name": "@octanejs/streamdown",
  "version": "0.1.29",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "Complete Streamdown 2.5 bindings for Octane, including code, math, Mermaid, and CJK plugin entry points.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/streamdown"
  },
  "main": "dist/server/index.js",
  "module": "dist/client/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/client/index.js",
      "node": "./dist/server/index.js",
      "default": "./dist/client/index.js"
    },
    "./code": {
      "types": "./dist/types/code.d.ts",
      "browser": "./dist/client/code.js",
      "node": "./dist/server/code.js",
      "default": "./dist/client/code.js"
    },
    "./math": {
      "types": "./dist/types/math.d.ts",
      "browser": "./dist/client/math.js",
      "node": "./dist/server/math.js",
      "default": "./dist/client/math.js"
    },
    "./mermaid": {
      "types": "./dist/types/mermaid-plugin.d.ts",
      "browser": "./dist/client/mermaid.js",
      "node": "./dist/server/mermaid.js",
      "default": "./dist/client/mermaid.js"
    },
    "./cjk": {
      "types": "./dist/types/cjk.d.ts",
      "browser": "./dist/client/cjk.js",
      "node": "./dist/server/cjk.js",
      "default": "./dist/client/cjk.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run --root ../.. --project streamdown --project streamdown-differential --project streamdown-ssr",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsgo --noEmit -p typetests/tsconfig.json",
    "types:check": "node scripts/generate-tsrx-types.mjs --check && node scripts/check-public-types.mjs",
    "types:generate": "node scripts/generate-tsrx-types.mjs"
  },
  "dependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "clsx": "catalog:default",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "html-url-attributes": "^3.0.1",
    "katex": "^0.16.27",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "rehype-harden": "^1.1.8",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-cjk-friendly": "^2.0.1",
    "remark-cjk-friendly-gfm-strikethrough": "^2.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remend": "^1.3.0",
    "shiki": "catalog:default",
    "tailwind-merge": "catalog:default",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "unist-util-visit-parents": "^6.0.0"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/jest-dom": "catalog:default",
    "@tsrx/react": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "esbuild": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "streamdown": "2.5.0",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@streamdown/cjk": "1.0.3",
    "vitest": "catalog:default"
  }
}
