{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "noErrorTruncation": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@octanejs/streamdown": ["../src/index.tsrx.d.ts"],
      "@octanejs/streamdown/code": ["../src/code.ts"],
      "@octanejs/streamdown/math": ["../src/math.ts"],
      "@octanejs/streamdown/mermaid": ["../src/mermaid-plugin.ts"],
      "@octanejs/streamdown/cjk": ["../src/cjk.ts"]
    }
  },
  "include": ["./**/*.test-d.ts"]
}
