{
  "name": "@octanejs/effect-atom-react",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "@effect/atom-react for Octane: the Effect Atom hooks, RegistryProvider, HydrationBoundary and ScopedAtom, ported from @effect/atom-react 4.1.0.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/effect-atom-react"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE",
    "LICENSE.upstream",
    "LICENSE.upstream-root"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Hooks": "./src/Hooks.tsrx",
    "./ReactHydration": "./src/ReactHydration.tsrx",
    "./RegistryContext": "./src/RegistryContext.tsrx",
    "./ScopedAtom": "./src/ScopedAtom.tsrx",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project effect-atom-react --project effect-atom-react-pristine --project effect-atom-react-adapted --project effect-atom-react-differential",
    "typecheck": "octane-tsc -p tsconfig.json",
    "upstream:verify": "node ../../scripts/react-parity/verify-provenance.mjs",
    "upstream:test": "node ../../scripts/react-parity/run-pristine.mjs effect-atom-react"
  },
  "peerDependencies": {
    "effect": "^4.1.0",
    "octane": "workspace:^0.16.0"
  },
  "devDependencies": {
    "@octanejs/react-error-boundary": "workspace:*",
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "catalog:default",
    "@types/react": "catalog:default",
    "@types/scheduler": "0.26.0",
    "effect": "4.1.0",
    "jsdom": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-error-boundary": "catalog:default",
    "scheduler": "0.27.0",
    "vitest": "catalog:default"
  }
}
