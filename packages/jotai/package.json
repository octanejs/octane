{
  "name": "@octanejs/jotai",
  "version": "0.1.49",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "jotai bindings for the octane renderer \u2014 reuses jotai's framework-agnostic vanilla atoms/store and swaps the React binding for an octane port of jotai/react.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/jotai"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE",
    "LICENSE.upstream"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./vanilla": "./src/vanilla.ts",
    "./vanilla/utils": "./src/vanilla/utils.ts",
    "./vanilla/internals": "./src/vanilla/internals.ts",
    "./react": "./src/react.ts",
    "./react/utils": "./src/react/utils.ts",
    "./utils": "./src/utils.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --config vitest.config.js --project jotai --project jotai-differential --project jotai-pristine",
    "upstream:check": "node ../../scripts/react-port/materialize.mjs run --check --package-dir .",
    "upstream:test": "node ../../scripts/react-parity/run-pristine.mjs jotai",
    "upstream:verify": "node ../../scripts/react-parity/verify-provenance.mjs --package-dir ."
  },
  "dependencies": {
    "jotai": "catalog:default"
  },
  "peerDependencies": {
    "octane": "workspace:^0.1.51 || ^0.2.0"
  },
  "devDependencies": {
    "@tsrx/react": "catalog:default",
    "esbuild": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vitest": "catalog:default",
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/react": "catalog:default",
    "@testing-library/jest-dom": "catalog:default",
    "rxjs": "catalog:default",
    "wonka": "6.3.6",
    "jest-leak-detector": "30.5.1",
    "@types/node": "catalog:default",
    "vite": "catalog:default",
    "typescript": "6.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
