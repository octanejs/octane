{
  "name": "@octanejs/motion",
  "version": "0.1.37",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "Framer Motion bindings for the octane renderer — reuses motion-dom's animation engine, swaps the React components for octane host components.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/motion"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react-m": "./src/react-m.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project motion",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test:upstream": "jest --config tests/upstream-jest.config.cjs --rootDir upstream --runInBand --no-watchman",
    "upstream:verify": "node ./scripts/verify-upstream.mjs"
  },
  "dependencies": {
    "motion": "catalog:default",
    "motion-dom": "catalog:default"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@swc/core": "1.15.41",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "catalog:default",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "16.3.2",
    "@tsrx/react": "catalog:default",
    "esbuild": "catalog:default",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-fixed-jsdom": "0.0.10",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vitest": "catalog:default"
  }
}
