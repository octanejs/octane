  "divergences": [
    {
      "id": "motion-exit-cleanup-before-detach",
      "caseIds": ["conformance:exit-cleanup-before-detach"],
      "upstreamResult": "React Motion keeps exiting nodes attached until exit animations finish via deferred deletion.",
      "octaneResult": "AnimatePresence clones the leaving node, detaches the original immediately, and removes the clone when exit completes.",
      "rationale": "Octane has no React deferred-deletion machinery; exit uses cleanup-before-detach.",
      "classification": "framework-integration",
      "consumerImpact": "Observers of live child counts during exit see the original node leave earlier than on React.",
      "migrationGuidance": "Prefer AnimatePresence completion callbacks over counting live DOM children mid-exit.",
      "owner": "@octanejs/motion",
      "reviewCondition": "Review if Octane gains deferred-deletion semantics equivalent to React."
    },
    {
      "id": "motion-bounded-layout-flip",
      "caseIds": ["conformance:bounded-layout-flip"],
      "upstreamResult": "React Motion layout animations participate in the full projection tree with nested scale correction.",
      "octaneResult": "layout uses single-element FLIP from getBoundingClientRect deltas only.",
      "rationale": "The port ships a bounded FLIP path rather than Motion's projection tree.",
      "classification": "framework-integration",
      "consumerImpact": "Nested layout/scale correction and shared-layout-during-drag cases diverge from React Motion.",
      "migrationGuidance": "Keep layout animations to single-element size/position changes; avoid nested projection-dependent layouts.",
      "owner": "@octanejs/motion",
      "reviewCondition": "Review if a projection-tree layout port lands."
    },
    {
      "id": "motion-bounded-layoutId",
      "caseIds": ["conformance:bounded-layoutId"],
      "upstreamResult": "React Motion layoutId shared-element transitions use the projection tree.",
      "octaneResult": "layoutId uses a bounded single-element crossfade/FLIP path.",
      "rationale": "Shared-element transitions are intentionally bounded with the FLIP implementation.",
      "classification": "framework-integration",
      "consumerImpact": "Complex shared-layout graphs may not match React Motion pixel-for-pixel.",
      "migrationGuidance": "Use layoutId for simple shared-element pairs; avoid nested projection-dependent shared layouts.",
      "owner": "@octanejs/motion",
      "reviewCondition": "Review if full shared-layout projection lands."
    },
    {
      "id": "motion-initial-only-no-style-materialization",
      "caseIds": ["conformance:initial-only-no-style-materialization"],
      "upstreamResult": "React Motion materializes inline styles for an initial target even without an animate target.",
      "octaneResult": "An initial-only target leaves inline styles unset until an animation target exists.",
      "rationale": "Octane only materializes animated style targets; initial-only is not applied as static inline style.",
      "classification": "framework-integration",
      "consumerImpact": "Components that rely on initial-only inline styles for first paint look unstyled on Octane.",
      "migrationGuidance": "Set the starting style explicitly or provide an animate target; differential fixtures use initial={false}.",
      "owner": "@octanejs/motion",
      "reviewCondition": "Review if Octane materializes initial-only styles like React Motion."
    },
    {
      "id": "motion-zero-transform-serialization",
      "caseIds": ["runtime:a6edd8704002ab6c"],
      "upstreamResult": "A MotionValue of 0 bound to style.x serializes as transform: none.",
      "octaneResult": "A MotionValue of 0 bound to style.x serializes as translateX(0px).",
      "rationale": "Octane rebuilds the transform string from shorthand keys, including an explicit zero translate.",
      "classification": "framework-integration",
      "consumerImpact": "Computed style / CSSOM string equality against React Motion may differ at zero.",
      "migrationGuidance": "Prefer reading MotionValue.get() or numeric style intent over exact transform string equality at zero.",
      "owner": "@octanejs/motion",
      "reviewCondition": "Review if Octane collapses zero transforms to none."
    }
  ]
}
