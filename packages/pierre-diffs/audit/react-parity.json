      "id": "strict-mode-replay",
      "caseIds": ["runtime:132cf045438d20aa", "runtime:e300530db219c227"],
      "upstreamResult": "Under StrictMode, React's simulated unmount and remount creates a second editor per surface, and the first is cleaned up.",
      "octaneResult": "Octane creates the committed editor only; the cleanup and no-leak assertions hold unchanged.",
      "rationale": "Octane's StrictMode does not double-invoke mounts.",
      "classification": "strict-mode",
      "consumerImpact": "None: StrictMode replays are development-only.",
      "reviewCondition": "Review if Octane StrictMode gains mount replay."
