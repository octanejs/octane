  "divergences": [
    {
      "id": "popper-octane-node-and-ref-types",
      "caseIds": ["types:popper-adapted-main", "types:popper-adapted-svg"],
      "upstreamResult": "Public props use React.ReactNode, React.Ref, and React.CSSProperties around class components.",
      "octaneResult": "Public props use OctaneNode, plain Ref callback/object unions, and CSSProperties while Manager/Reference/Popper are function components.",
      "rationale": "Octane has no class components and represents renderables/refs with its own structural types.",
      "classification": "type-surface",
      "consumerImpact": "Type imports that expect React.ReactNode or component classes must switch to OctaneNode and function components.",
      "migrationGuidance": "Type children and render-prop returns as OctaneNode; keep runtime render-function values unchanged.",
      "owner": "@octanejs/popper",
      "reviewCondition": "Review if Octane publishes React-compatible ReactNode/class-component shims for bindings."
    },
    {
      "id": "popper-dev-warning-console",
      "caseIds": ["runtime:baa5fd0dba1358db"],
      "upstreamResult": "Reference misuse warnings go through react-popper's warning helper.",
      "octaneResult": "Reference misuse warnings are emitted with console.error using the same warning text.",
      "rationale": "The Octane binding avoids depending on the upstream warning helper while preserving the developer-facing message.",
      "classification": "dev-warning",
      "consumerImpact": "Tests that mock the upstream warning helper must mock console.error instead.",
      "migrationGuidance": "Assert console.error for the Reference-outside-Manager warning in development.",
      "owner": "@octanejs/popper",
      "reviewCondition": "Review if Octane adopts a shared binding warning helper."
    }
