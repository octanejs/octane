      "import": "./src/mutation/index.ts",
      "require": "./src/mutation/index.cts"
    },
    "./_internal": {
      "react-server": "./src/_internal/index.react-server.ts",
      "import": {
        "types": "./src/_internal/index.ts",
        "default": "./src/_internal/index.ts"
      },
      "require": {
        "types": "./src/_internal/index.ts",
        "default": "./src/_internal/index.cts"
      }
    }
  },
  "scripts": {
    "u1:architecture": "vitest run ./tests/probes/architecture.test.ts ../../packages/octane/tests/hydration/hydration.test.ts ../../packages/octane/tests/hydration/suspense-hydrate.test.ts ../../packages/octane/tests/streaming-ssr.test.ts --config ./tests/probes/vitest.config.mjs",
    "u1:pack": "node ./tests/probes/packed-exports.test.mjs",
    "u2:test": "vitest run ./tests/unit ./tests/differential --config ./tests/probes/vitest.config.mjs",
    "u2:types": "tsc -p ./typetests/internal/tsconfig.json",
    "u3:test": "vitest run ./tests/upstream/root ./tests/differential/root.test.ts --config ./tests/probes/vitest.config.mjs",
    "u3:types": "tsrx-tsc --noEmit -p ./typetests/root/tsconfig.json",
    "u4:test": "vitest run ./tests/upstream/specialized ./tests/differential/specialized-exports.test.ts --config ./tests/probes/vitest.config.mjs",
    "u4:types": "tsrx-tsc --noEmit -p ./typetests/specialized/tsconfig.json",
    "upstream:verify": "node ./audit/verify-provenance.mjs",
    "u6:adoption": "vitest run ./tests/adoption --config ./tests/probes/vitest.config.mjs",
    "u6:types": "tsrx-tsc --noEmit -p ./tests/adoption/tsconfig.json"
  },
