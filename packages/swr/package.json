      "types": "./src/infinite/index.d.ts",
      "import": "./src/infinite/index.ts",
      "require": "./src/infinite/index.cts"
    },
    "./immutable": {
      "import": {
        "types": "./src/immutable/index.ts",
        "default": "./src/immutable/index.ts"
      },
      "require": {
        "types": "./src/immutable/index.ts",
        "default": "./src/immutable/index.cts"
      }
    },
    "./subscription": {
      "types": "./src/subscription/index.d.ts",
