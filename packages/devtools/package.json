{
  "name": "@octanejs/devtools",
  "version": "0.0.38",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "Octane DevTools — a TanStack Devtools plugin exposing live Octane runtime diagnostics (component tree, state, profiler).",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/devtools"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/devtools": "catalog:default",
    "@tanstack/devtools-event-client": "catalog:default"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@tanstack/devtools-event-bus": "catalog:default",
    "@testing-library/jest-dom": "catalog:default",
    "octane": "workspace:*",
    "vitest": "catalog:default"
  }
}
