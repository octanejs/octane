      ],
      "upstreamResult": "The React suite counts every global scheduling call as if each belonged to the hook.",
      "octaneResult": "The native suite identifies the hook timer by its requested delay and returned handle, then verifies its exact cancellation and the same observable callback/state behavior.",
      "rationale": "Octane uses additional scheduler timers; their global count is not part of Mantine’s hook API. The idle case also explicitly advances the fake clock so its deadline assertion executes.",
      "classification": "framework-abi",
      "consumerImpact": "Hook deadlines, callbacks, state updates and cleanup remain compatible; framework scheduling internals differ.",
      "migrationGuidance": "Observe the timer owned by the hook, its deadline and its callback rather than all global timer activity.",
      "owner": "@octanejs/mantine-hooks",
      "reviewCondition": "Review when Mantine changes timer ownership or cleanup guarantees."
    }
  ]
