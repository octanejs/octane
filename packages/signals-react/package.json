{
  "name": "@octanejs/signals-react",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "@preact/signals-react bindings for Octane, reusing @preact/signals-core 1.14.4.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/signals-react"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./utils": "./src/utils/index.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --config vitest.config.js --project signals-react",
    "typecheck": "tsrx-tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals-core": "1.14.4"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "octane": "workspace:*",
    "vitest": "catalog:default"
  }
}
