  "divergences": [
    {
      "id": "xstate-store-call-site-hook-slots",
      "caseIds": ["ordinary:xstate-store-hook-slot-per-call-site"],
      "ordinaryEvidence": [
        {
          "path": "packages/xstate-store/tests/conformance/binding.test.ts",
          "id": "ordinary:xstate-store-hook-slot-per-call-site",
          "testName": "gives each selector call site its own hook slot",
          "fullName": "useSelector gives each selector call site its own hook slot",
          "sha256": "140b5e97891aaa41d60759c5e480c290d3de6464b280f460ec323476fd8aa385"
        }
      ],
      "upstreamResult": "React keys hooks by call order, so upstream's hook calls inside the `if` branches of useSelector and useAtom are tolerated only because the branch is stable for a given call site. A call site that flips between the selector and no-selector branch corrupts React's hook order.",
      "octaneResult": "Octane keys hooks by compiler-assigned call-site slot, so each branch owns an independent hook cell. The branching shape is kept verbatim from upstream and is simply legal here; a flipping call site keeps working and the abandoned branch's subscription is released.",
      "rationale": "The divergence follows from Octane's slot-keyed hook model, which is a framework-level design decision rather than a choice made by this binding.",
      "classification": "framework-model",
      "consumerImpact": "Strictly better-behaved than React on the same source. No supported usage reaches the difference, because both hooks' branch condition is fixed by the argument shape at each call site.",
      "migrationGuidance": "None required. Code that is correct on React stays correct here.",
      "owner": "@octanejs/xstate-store",
      "reviewCondition": "Review if Octane ever adopts call-order hook keying, or if upstream restructures useSelector/useAtom to hoist the hooks out of the branches."
    }
  ]
