  "divergences": [
    {
      "id": "error-boundary-component",
      "caseIds": ["runtime:222a37e241fbd87c", "runtime:b2fdd42669fec3a9"],
      "upstreamResult": "The cases catch render errors with a class component using getDerivedStateFromError.",
      "octaneResult": "The adaptation catches them with Octane's ErrorBoundary and the same fallback text.",
      "rationale": "Octane has no class components; ErrorBoundary is its catch-only boundary.",
      "classification": "framework-component-model",
      "consumerImpact": "None for this binding; boundaries are authored as ErrorBoundary or @try/@catch.",
      "migrationGuidance": "Replace class error boundaries with ErrorBoundary or @try/@catch.",
      "reviewCondition": "Revisit if Octane adds class components.",
      "owner": "octanejs"
    },
    {
      "id": "getsnapshot-error-render",
      "caseIds": ["runtime:0db587ce88b27185"],
      "upstreamResult": "A class boundary held by a createRef ref catches the error, and React's concurrent root renders the tree that threw a second time, so the fallback logs twice.",
      "octaneResult": "Octane's ErrorBoundary catches it with a {current} ref, and its fallback renders once, as React 17 legacy roots and the upstream shim variant do.",
      "rationale": "Octane has no class components or createRef, and renders synchronously without retrying a render that threw to attempt recovery.",
      "classification": "scheduler-model",
      "consumerImpact": "An erroring store selector is called one fewer time.",
      "migrationGuidance": "Do not depend on the number of renders of an erroring tree.",
      "reviewCondition": "Revisit if Octane adopts React's concurrent error recovery.",
      "owner": "octanejs"
    },
    {
      "id": "octane-diagnostics",
      "caseIds": ["runtime:25672a9582eaac62"],
      "upstreamResult": "React's uncached-snapshot warning and update-depth error use React's wording.",
      "octaneResult": "Octane reports the same two conditions in its own wording.",
      "rationale": "Octane words its own diagnostics.",
      "classification": "diagnostics",
      "consumerImpact": "Code matching React message text must match Octane text instead.",
      "migrationGuidance": "Match on the condition, not on the message text.",
      "reviewCondition": "Revisit if Octane adopts React message text.",
      "owner": "octanejs"
    },
    {
      "id": "foreign-server-markup",
      "caseIds": ["runtime:af99467e762c6999"],
      "upstreamResult": "React hydrates hand-written <div>server</div>, reading getServerSnapshot first and adopting the div held by a createRef ref.",
      "octaneResult": "Octane renders that root on the client and reports error #348 through onRecoverableError. tests/conformance.test.ts hydrates Octane server output: server snapshot first, then the client state, adopting the server DOM.",
      "rationale": "Octane adopts only markup written by its own server renderer, identified by its hydration protocol comment. It has no createRef; any {current} object is a ref.",
      "classification": "ssr-hydration",
      "consumerImpact": "Server HTML from another renderer is replaced rather than adopted.",
      "migrationGuidance": "Render the server HTML with octane/server.",
      "reviewCondition": "Revisit if Octane adopts markup without its hydration protocol.",
      "owner": "octanejs"
    },
    {
      "id": "noop-renderer-host",
      "caseIds": ["runtime:194b8479ad647fdd", "runtime:60a41de7c299204e"],
      "upstreamResult": "The native cases render through react-noop-renderer in a Node environment.",
      "octaneResult": "The adaptation renders through Octane's client root in a DOM environment.",
      "rationale": "Octane resolves its client runtime only in a DOM environment; the noop renderer has no Octane counterpart.",
      "classification": "test-harness",
      "consumerImpact": "None; React Native is not an Octane target.",
      "migrationGuidance": "None.",
      "reviewCondition": "Revisit if Octane gains a host-agnostic test renderer.",
      "owner": "octanejs"
    },
    {
      "id": "built-in-shim",
      "caseIds": ["runtime:e3d3a4583dea3b87"],
      "upstreamResult": "With React's built-in hook removed, the shim's server fallback ignores getServerSnapshot, and renderToString returns 'client'.",
      "octaneResult": "The shim is Octane's built-in hook, which renders getServerSnapshot; renderToStaticMarkup returns {html: 'server'}.",
      "rationale": "The userspace fallback serves only React 16 and 17; Octane always has the built-in hook, which the published shim also selects on React 18+. Octane's server renderers return a result object, and only static markup omits hydration ranges.",
      "classification": "framework-component-model",
      "consumerImpact": "Server rendering through /shim uses getServerSnapshot, as on React 18+.",
      "migrationGuidance": "Pass getServerSnapshot for content that must match the client.",
      "reviewCondition": "None while Octane exports a built-in useSyncExternalStore.",
      "owner": "octanejs"
    }
  ]
