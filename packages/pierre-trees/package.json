    "directory": "packages/pierre-trees"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE",
    "LICENSE.upstream",
    "NOTICE.upstream"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
