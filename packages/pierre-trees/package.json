  "engines": {
    "node": ">=22.22.2"
  },
  "description": "@pierre/trees/react for Octane: the FileTree component and the useFileTree, useFileTreeSelector, useFileTreeSelection and useFileTreeSearch hooks, ported from @pierre/trees 1.0.0-beta.6.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
