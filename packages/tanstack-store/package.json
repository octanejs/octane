{
  "name": "@octanejs/tanstack-store",
  "version": "0.0.44",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "TanStack Store bindings for Octane — reuses the framework-agnostic @tanstack/store core with an Octane hook adapter.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/tanstack-store"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE.upstream"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:upstream": "node ../../scripts/react-parity/run-pristine.mjs tanstack-store",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.adapted.json && tsrx-tsc --noEmit -p typetests/tsconfig.json",
    "upstream:verify": "node ../../scripts/react-port/materialize.mjs run --check --package-dir ."
  },
  "dependencies": {
    "@tanstack/store": "0.11.0"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@tanstack/react-store": "catalog:tanstack-store-react-oracle",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "catalog:tanstack-store-react-oracle",
    "@testing-library/user-event": "^14.6.1",
    "@tsrx/react": "catalog:default",
    "@types/react": "catalog:tanstack-store-react-oracle",
    "@types/react-dom": "catalog:tanstack-store-react-oracle",
    "@types/use-sync-external-store": "^1.5.0",
    "esbuild": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:tanstack-store-react-oracle",
    "react-dom": "catalog:tanstack-store-react-oracle",
    "use-sync-external-store": "catalog:tanstack-store-react-oracle",
    "vitest": "catalog:default"
  }
}
