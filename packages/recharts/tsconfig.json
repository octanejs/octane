{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "noEmit": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "noErrorTruncation": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "allowImportingTsExtensions": true
  },
  "include": ["./src/"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/chart/types.ts",
    "src/context/useTooltipAxis.ts",
    "src/state/selectors/areaSelectors.ts",
    "src/state/selectors/funnelSelectors.ts",
    "src/state/selectors/pieSelectors.ts",
    "src/state/selectors/polarGridSelectors.ts",
    "src/state/selectors/polarScaleSelectors.ts",
    "src/state/selectors/polarSelectors.ts",
    "src/state/selectors/radarSelectors.ts",
    "src/state/selectors/radialBarSelectors.ts",
    "src/state/selectors/scatterSelectors.ts",
    "src/util/cursor/getCursorPoints.ts",
    "src/util/cursor/getCursorRectangle.ts",
    "src/util/cursor/getRadialCursorPoints.ts",
    "src/util/scale/CartesianScaleHelper.ts",
    "src/util/tooltip/translate.ts"
  ]
}
