{
  "name": "@octanejs/monaco-editor",
  "version": "0.0.18",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "Monaco Editor components and loader hooks for Octane, ported from @monaco-editor/react without a React runtime dependency.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/monaco-editor"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "UPSTREAM.md",
    "LICENSE.upstream"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project monaco-editor",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json",
    "parity:generate": "node ./scripts/generate-parity-manifest.mjs"
  },
  "dependencies": {
    "@monaco-editor/loader": "catalog:default"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.25.0 <1",
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@monaco-editor/react": "catalog:default",
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "16.3.2",
    "@tsrx/react": "catalog:default",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "catalog:default",
    "esbuild": "catalog:default",
    "monaco-editor": "catalog:default",
    "octane": "workspace:*",
    "playwright": "catalog:default",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "catalog:default",
    "vitest": "catalog:default"
  }
}
