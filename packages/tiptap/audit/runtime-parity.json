  "permittedTransformations": [
    {
      "kind": "import-root",
      "rule": "React Testing Library and relative @tiptap/react imports become @octanejs/testing-library and @octanejs/tiptap"
    },
    {
      "kind": "create-element",
      "rule": "React.createElement / React.Fragment / createRef become octane createElement / Fragment / plain ref objects"
    },
    {
      "kind": "callback-style",
      "rule": "Arrow callbacks may become function declarations; unregisterCalls.some(([key]) => …) may become function (call) { return call[0] === … }"
