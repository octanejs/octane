  "assertionReplacements": [
    {
      "divergenceId": "tiptap-native-menu-events",
      "pristine": "packages/tiptap/upstream/src/menus/BubbleMenu.spec.ts",
      "title": "applies html props to the actual menu element",
      "replacements": [
        {
          "from": "expect(lastEvent.nativeEvent).toBeInstanceOf(MouseEvent)",
          "to": "expect(lastEvent?.event).toBeInstanceOf(MouseEvent)"
        },
        {
          "from": "expect(lastEvent.currentTarget).toBe(element)",
          "to": "expect(lastEvent?.currentTarget).toBe(element)"
        },
        {
          "from": "expect(lastEvent.target).toBeInstanceOf(Element)",
          "to": "expect(lastEvent?.target).toBeInstanceOf(Element)"
        },
        {
          "from": "expect(typeof lastEvent.persist).toBe('function')",
          "to": "expect('nativeEvent' in (lastEvent?.event as object)).toBe(false)"
        }
      ]
    }
  ]
