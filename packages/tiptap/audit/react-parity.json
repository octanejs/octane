    {
      "id": "tiptap-native-menu-events",
      "caseIds": ["runtime:6b2bf62b801a2b07"],
      "upstreamResult": "React menu handlers receive synthetic events.",
      "octaneResult": "Menu handlers receive native MouseEvent instances.",
      "rationale": "Octane dispatches native browser events.",
      "classification": "framework-integration",
      "consumerImpact": "There is no nativeEvent wrapper property.",
      "migrationGuidance": "Use standard DOM event fields directly.",
      "owner": "@octanejs/tiptap",
      "reviewCondition": "Review if Octane introduces synthetic events."
    },
    {
      "id": "tiptap-node-view-as-prop",
      "caseIds": ["differential:tiptap-node-view-as-prop"],
      "upstreamResult": "NodeViewWrapper forwards the as prop onto the host DOM node as an invalid attribute.",
      "octaneResult": "NodeViewWrapper consumes as when selecting the host tag and does not forward it.",
      "rationale": "Octane treats as as a host-tag selector rather than a passthrough DOM attribute.",
      "classification": "dom-attribute",
      "consumerImpact": "Selectors and attribute snapshots must not expect an as attribute on the rendered host.",
      "migrationGuidance": "Pass as only to choose the host tag; read tagName instead of the as attribute.",
      "owner": "@octanejs/tiptap",
      "reviewCondition": "Review if Octane starts forwarding unknown host props differently."
    },
    {
      "id": "tiptap-mark-view-portal-cleanup",
      "caseIds": ["differential:tiptap-mark-view-portal-cleanup"],
      "upstreamResult": "ReactMarkView can leave a renderer portal registered after ProseMirror destroys the mark view.",
      "octaneResult": "ReactMarkView.destroy unregisters and destroys the Octane portal immediately.",
      "rationale": "Octane closes the known @tiptap/react 3.28.0 mark-view portal leak on destroy.",
      "classification": "lifecycle",
      "consumerImpact": "Mark removal must not retain detached portal hosts or stale mark-view refs.",
      "migrationGuidance": "Rely on destroy-driven portal teardown; do not keep manual mark-view registries for this pin.",
      "owner": "@octanejs/tiptap",
      "reviewCondition": "Review if upstream mark-view destroy semantics change."
    }
  ]
