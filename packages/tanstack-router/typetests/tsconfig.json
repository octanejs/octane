{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest"],
    "paths": {
      "@octanejs/tanstack-router": ["../src/index.ts"],
      "@octanejs/tanstack-router/compiled": ["../src/compiled.ts"]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["./*.test-d.ts", "../src/**/*.ts", "../src/**/*.tsrx"],
  "exclude": ["../src/**/*.d.ts"]
}
