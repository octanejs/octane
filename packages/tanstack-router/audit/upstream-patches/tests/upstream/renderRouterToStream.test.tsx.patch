+function createRendererStream(signal?: AbortSignal, aborted = vi.fn()) {
+  let controller!: ReadableStreamDefaultController<Uint8Array>
+  let finish!: () => void
+  let terminal = false
+  const allReady = new Promise<void>((resolve) => { finish = resolve })
+  const fail = (reason: unknown) => {
+    if (terminal) return
+    terminal = true
+    controller.error(reason)
+    signal?.removeEventListener('abort', onAbort)
+    finish()
+  }
+  const onAbort = () => { aborted(); fail(signal!.reason) }
+  const stream = Object.assign(new ReadableStream<Uint8Array>({
+    start(value) { controller = value },
+    cancel() {
+      terminal = true
+      signal?.removeEventListener('abort', onAbort)
+      finish()
+    },
+  }), { allReady })
+  if (signal?.aborted) onAbort()
+  else signal?.addEventListener('abort', onAbort, { once: true })
+  return { stream, fail, aborted }
+}
