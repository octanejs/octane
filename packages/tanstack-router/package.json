{
  "name": "@octanejs/tanstack-router",
  "version": "0.1.48",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "TanStack Router bindings for the octane renderer — reuses @tanstack/router-core and swaps the React binding for octane's hooks.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/tanstack-router"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./history": "./src/history.ts",
    "./ssr/server": {
      "types": "./src/ssr/server.ts",
      "default": "./src/ssr/server.ts"
    },
    "./ssr/client": {
      "types": "./src/ssr/client.ts",
      "default": "./src/ssr/client.ts"
    },
    "./generator-plugin": {
      "types": "./src/generator-plugin.d.ts",
      "default": "./src/generator-plugin.js"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./router-generator": {
      "types": "./src/router-generator/index.d.ts",
      "default": "./src/router-generator/index.js"
    },
    "./router-plugin": {
      "types": "./src/router-plugin/index.d.ts",
      "default": "./src/router-plugin/index.js"
    },
    "./router-plugin/context": {
      "types": "./src/router-plugin/context.d.ts",
      "default": "./src/router-plugin/context.js"
    },
    "./router-plugin/vite": {
      "types": "./src/router-plugin/vite.d.ts",
      "default": "./src/router-plugin/vite.js"
    },
    "./router-plugin/rspack": {
      "types": "./src/router-plugin/rspack.d.ts",
      "default": "./src/router-plugin/rspack.js"
    },
    "./router-plugin/webpack": {
      "types": "./src/router-plugin/webpack.d.ts",
      "default": "./src/router-plugin/webpack.js"
    },
    "./router-plugin/esbuild": {
      "types": "./src/router-plugin/esbuild.d.ts",
      "default": "./src/router-plugin/esbuild.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "catalog:default",
    "@babel/template": "^7.27.2",
    "@babel/types": "^7.28.5",
    "@tanstack/history": "catalog:default",
    "@tanstack/router-core": "catalog:default",
    "@tanstack/router-utils": "1.162.2",
    "@tanstack/store": "catalog:default",
    "@tanstack/virtual-file-routes": "1.162.0",
    "chokidar": "^5.0.0",
    "isbot": "^5.1.22",
    "jiti": "^2.7.0",
    "magic-string": "^0.30.21",
    "prettier": "catalog:default",
    "unplugin": "^3.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "octane": "workspace:*",
    "vite": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-router": "catalog:default",
    "@types/babel__core": "catalog:default",
    "@tsrx/react": "catalog:default",
    "esbuild": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vite": "catalog:default",
    "vitest": "catalog:default"
  }
}
