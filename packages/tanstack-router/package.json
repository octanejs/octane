{
  "name": "@octanejs/tanstack-router",
  "version": "0.1.53",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "TanStack Router bindings for the octane renderer \u2014 reuses @tanstack/router-core and swaps the React binding for octane's hooks.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/tanstack-router"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "README.md",
    "LICENSE.upstream",
    "LICENSE.node-types",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./history": "./src/history.ts",
    "./ssr/server": {
      "types": "./src/ssr/server.ts",
      "default": "./src/ssr/server.ts"
    },
    "./ssr/client": {
      "types": "./src/ssr/client.ts",
      "default": "./src/ssr/client.ts"
    },
    "./generator-plugin": {
      "types": "./src/generator-plugin.d.ts",
      "default": "./src/generator-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project tanstack-router --project tanstack-router-ssr --project tanstack-router-differential --project tanstack-router-pristine --project tanstack-router-browser",
    "upstream:check": "node ../../scripts/react-parity/verify-provenance.mjs --package-dir ."
  },
  "dependencies": {
    "@tanstack/history": "1.162.3",
    "@tanstack/router-core": "1.171.29",
    "@tanstack/store": "0.11.1",
    "isbot": "5.2.1"
  },
  "peerDependencies": {
    "octane": "workspace:^0.1.51 || ^0.2.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "1.170.35",
    "@tsrx/react": "catalog:default",
    "esbuild": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vitest": "catalog:default",
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/react": "catalog:default",
    "@testing-library/jest-dom": "catalog:default",
    "@tanstack/react-query": "5.102.8",
    "combinate": "1.1.11",
    "zod": "4.5.4",
    "@tanstack/react-store": "0.11.1",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default"
  }
}
