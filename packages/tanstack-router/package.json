{
  "name": "@octanejs/tanstack-router",
  "version": "0.3.4",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    },
    "strong": [
      "src/ClientOnly.tsrx",
      "src/ErrorComponent.tsrx",
      "src/ScriptOnce.tsrx",
      "src/Transitioner.tsrx",
      "src/assetComponent.tsrx",
      "src/compiled/Document.tsrx",
      "src/compiled/HydrationRangeOwner.tsrx",
      "src/compiled/Link.tsrx",
      "src/compiled/Matches.tsrx",
      "src/compiled/bindings.ts",
      "src/compiled/route.tsrx",
      "src/compiled/serverDocument.client.ts",
      "src/compiled/serverDocument.tsrx",
      "src/headContentBinding.ts",
      "src/hookBindings.ts",
      "src/internal.ts",
      "src/linkBinding.ts",
      "src/linkComponent.tsrx",
      "src/routeHookBindings.ts",
      "src/router.ts",
      "src/routerStateBinding.ts",
      "src/scriptComponent.tsrx",
      "src/scriptContentBinding.ts",
      "src/useStore.ts"
    ]
  },
  "description": "TanStack Router bindings for the octane renderer — reuses @tanstack/router-core and swaps the React binding for octane's hooks.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/tanstack-router"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./history": "./src/history.ts",
    "./compiled": "./src/compiled.ts",
    "./ssr/server": {
      "types": "./src/ssr/server.ts",
      "default": "./src/ssr/server.ts"
    },
    "./ssr/client": {
      "types": "./src/ssr/client.ts",
      "default": "./src/ssr/client.ts"
    },
    "./generator-plugin": {
      "types": "./src/generator-plugin.d.ts",
      "default": "./src/generator-plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/history": "catalog:default",
    "@tanstack/router-core": "catalog:default",
    "@tanstack/store": "catalog:default",
    "isbot": "^5.1.22"
  },
  "peerDependencies": {
    "octane": "workspace:^"
  },
  "devDependencies": {
    "@tanstack/react-router": "catalog:default",
    "@tsrx/react": "catalog:default",
    "esbuild": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vitest": "catalog:default"
  },
  "imports": {
    "#server-document": {
      "browser": "./src/compiled/serverDocument.client.ts",
      "default": "./src/compiled/serverDocument.tsrx"
    }
  }
}
