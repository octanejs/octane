{
  "name": "@octanejs/formisch",
  "version": "0.0.5",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "Formisch bindings for Octane, with a vendored React-free Formisch core and modular methods.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/formisch"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project formisch",
    "test:parity": "node ../../scripts/react-parity/formisch-check.mjs",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.json"
  },
  "peerDependencies": {
    "octane": "workspace:*",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "@formisch/react": "catalog:default",
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/dom": "catalog:default",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsrx/react": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "valibot": "catalog:default",
    "vitest": "catalog:default"
  }
}
