{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": false,
    "types": ["node"],
    "noEmit": true,
    "noErrorTruncation": true,
    "baseUrl": "../../..",
    "paths": { "@octanejs/formisch": ["packages/formisch/src/index.ts"] }
  },
  "include": [
    "./public-api.test-d.ts",
    "./react-types-must-not-be-imported.d.ts",
    "./upstream/frameworks/react/**/*.test-d.ts",
    "./upstream/packages/methods/**/*.test-d.ts",
    "./upstream/packages/methods/src/vitest/**/*.ts"
  ]
}
