{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmitOnError": true,
    "noErrorTruncation": true,
    "allowSyntheticDefaultImports": true,
    "types": [],
    "strict": true
  },
  "include": ["./src/"],
  "exclude": ["node_modules", "dist", "audit"]
}
