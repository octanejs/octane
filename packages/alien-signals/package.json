{
  "name": "@octanejs/alien-signals",
  "version": "0.0.18",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "Alien Signals bindings for Octane, reusing the framework-neutral core with Octane-native subscription and lifecycle hooks.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/alien-signals"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE.upstream",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "pnpm upstream:verify && vitest run --root ../.. --project alien-signals --project alien-signals-ssr --maxWorkers=1",
    "upstream:verify": "node ../../scripts/react-parity/verify-provenance.mjs",
    "parity:inventory": "node ../../scripts/react-parity/alien-signals-runtime-inventory.mjs",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "alien-signals": "catalog:default"
  },
  "peerDependencies": {
    "octane": "workspace:^0.1.51 || ^0.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.2",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.2.3",
    "@types/node": "25.9.5",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "bun": "1.3.14",
    "octane": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vitest": "catalog:default",
    "react-alien-signals": "0.4.0",
    "pristine-bun-types": "npm:bun-types@1.3.14"
  }
}
