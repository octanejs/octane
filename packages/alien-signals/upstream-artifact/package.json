{
  "name": "react-alien-signals",
  "version": "0.4.0",
  "description": "Concurrency-safe React hooks for Alien Signals",
  "license": "MIT",
  "keywords": [
    "alien-signals",
    "react",
    "signals",
    "state-management",
    "typescript"
  ],
  "packageManager": "bun@1.3.14",
  "homepage": "https://rajaniraiyn.github.io/react-alien-signals/",
  "bugs": {
    "url": "https://github.com/Rajaniraiyn/react-alien-signals/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rajaniraiyn/react-alien-signals"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "build": "bun run scripts/build.ts",
    "benchmark": "bun run benchmarks/react.tsx",
    "compiler:check": "bun run scripts/check-react-compiler.ts",
    "docs": "typedoc src/index.ts",
    "docs:preview": "bun run docs && npx serve docs"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@happy-dom/global-registrator": "^17.1.3",
    "@tanstack/react-store": "^0.11.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/bun": "^1.2.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "alien-signals": "^3.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jotai": "^2.20.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typedoc": "^0.28.20",
    "typescript": "^5.7.3",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "alien-signals": "^3.2.1",
    "react": ">=19.2.0"
  },
  "workspaces": [
    "playground"
  ]
}
