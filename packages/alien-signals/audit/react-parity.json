  "divergences": [
    {
      "id": "alien-signals-readable-computed",
      "caseIds": ["types:alien-signals-adapted"],
      "upstreamResult": "Pinned react-alien-signals declarations narrow useSignalValue to WritableSignal, so readable computed probes are rejected.",
      "octaneResult": "useSignalValue accepts ReadableSignal, including createComputed results, matching the documented Octane surface.",
      "rationale": "Upstream docs and runtime treat computed signals as readable; the published React declaration is narrower than that contract. Octane corrects the accept surface without weakening the read-only computed negative control.",
      "classification": "type-surface",
      "consumerImpact": "Octane callers may pass createComputed results to useSignalValue; React declaration consumers cannot without casts.",
      "migrationGuidance": "Prefer ReadableSignal-typed values with useSignalValue on Octane. Keep paired type probes on writable count; use the Octane-only readable-computed typetest (ordinary package typecheck) for computed acceptance.",
      "owner": "@octanejs/alien-signals",
      "reviewCondition": "Review if upstream widens useSignalValue to ReadableSignal or Octane reintroduces a writable-only overload."
    },
    {
      "id": "alien-signals-use-signal-scope",
      "caseIds": ["runtime:5189801c40af28d9"],
      "upstreamResult": "useSignalScope starts createSignalScope during React render via useMemo and returns that stop handle; pre-commit cancellation is not modeled.",
      "octaneResult": "useSignalScope allocates a cancellation-safe controller during render, starts the scope after client commit via useEffect, and returns a stop that can cancel before commit.",
      "rationale": "Octane forbids render-phase effects. Deferring scope start to commit preserves SSR/hydration safety and makes pre-commit stop a no-op instead of racing a render-created scope.",
      "classification": "lifecycle",
      "consumerImpact": "Scope callbacks and nested effects do not run until after commit; calling stop before commit cancels startup rather than disposing an already-running scope.",
      "migrationGuidance": "Do not rely on scope work during the render that calls useSignalScope. Prefer post-commit observations; use the returned stop for cancellation-safe teardown including pre-commit abort.",
      "owner": "@octanejs/alien-signals",
      "reviewCondition": "Review if Octane gains a safe render-phase effect primitive or upstream moves scope creation out of useMemo."
    }
  ]
