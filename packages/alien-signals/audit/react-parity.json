  "divergences": [
    {
      "id": "alien-signals-use-signal-scope",
      "caseIds": ["runtime:5189801c40af28d9"],
      "upstreamResult": "Upstream 0.4.0 starts scopes after commit. Its returned stop disposes the active scope, but a call before commit does not cancel later startup.",
      "octaneResult": "The compatibility controller also starts after commit and remembers cancellation before commit or across callback/dependency replacement.",
      "rationale": "Preserve the existing Octane cancellation-safe stop contract while adopting upstream post-commit startup and optional dependencies.",
      "classification": "lifecycle",
      "consumerImpact": "Calling stop permanently cancels this mounted controller; upstream may start a scope on a later commit or dependency replacement.",
      "migrationGuidance": "Use the returned stop for permanent cancellation within the mounted component. Remount to create a new controller after cancellation.",
      "owner": "@octanejs/alien-signals",
      "reviewCondition": "Review if either package changes the public semantics of manual cancellation."
    }
  ]
