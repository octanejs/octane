{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": false,
    "types": ["node"],
    "noEmit": true,
    "noErrorTruncation": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "allowImportingTsExtensions": true,
    "paths": {
      "@octanejs/alien-signals": ["../src/index.ts"]
    }
  },
  "include": [
    "./upstream-typecheck.test-d.ts",
    "./public-api.test-d.ts",
    "../tests/types/public-api.ts"
  ],
  "reactPortEvidence": {
    "gate": "upstream-types-adapted",
    "upstreamRegistrations": [],
    "publicMode": "pinned"
  }
}
