{
  "name": "@octanejs/ink",
  "version": "0.0.13",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "sourceEnvironment": "node",
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "Ink for the Octane renderer — terminal UI components, hooks, Yoga layout, ANSI output, and interactive rendering ported from Ink 7.1.1.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/ink"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "LICENSE",
    "LICENSE.upstream",
    "README.md",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./renderer": "./src/renderer-entry.ts",
    "./intrinsics": "./src/intrinsics.ts",
    "./intrinsics/jsx-runtime": "./src/intrinsics.ts"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project ink --project ink-differential",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json && tsrx-tsc --noEmit -p typetests/tsconfig.json"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@types/signal-exit": "^3.0.0",
    "@types/stack-utils": "^2.0.3",
    "ansi-escapes": "^7.3.0",
    "ansi-styles": "^6.2.3",
    "auto-bind": "^5.0.1",
    "chalk": "^5.6.2",
    "cli-boxes": "^4.0.1",
    "cli-cursor": "^4.0.0",
    "cli-truncate": "^6.0.0",
    "code-excerpt": "^4.0.0",
    "es-toolkit": "^1.45.1",
    "indent-string": "^5.0.0",
    "is-in-ci": "^2.0.0",
    "patch-console": "^2.0.0",
    "signal-exit": "^3.0.7",
    "slice-ansi": "^9.0.0",
    "stack-utils": "^2.0.6",
    "string-width": "^8.2.0",
    "terminal-size": "^4.0.1",
    "type-fest": "^5.5.0",
    "widest-line": "^6.0.0",
    "wrap-ansi": "^10.0.0",
    "ws": "^8.20.0",
    "yoga-layout": "~3.2.1"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "8.1.0",
    "@tsrx/react": "catalog:default",
    "@types/node": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "typescript": "catalog:default",
    "vitest": "catalog:default"
  }
}
