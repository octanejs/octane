  "divergences": [
    {
      "id": "native-input-event",
      "caseIds": ["differential:input"],
      "upstreamResult": "onChange receives a React SyntheticEvent produced by React's change plugin.",
      "octaneResult": "onChange receives the native bubbling InputEvent with textarea target/currentTarget during dispatch.",
      "rationale": "Octane exposes native DOM events and does not ship React's synthetic event system.",
      "classification": "framework-event-model",
      "consumerImpact": "React-only SyntheticEvent fields and post-dispatch currentTarget retention are unavailable; tests assigning value directly must also dispatch input.",
      "migrationGuidance": "Read value from event.currentTarget during the callback, type shared handlers to the native event surface, and use real keyboard input or a bubbling InputEvent in tests.",
      "owner": "octanejs",
      "reviewCondition": "Revisit only if Octane introduces a public synthetic event compatibility layer."
    }
  ]
