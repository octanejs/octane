      "id": "native-table-renderer",
      "caseIds": [
        "runtime:04f25b5e91e1eac6",
        "runtime:764e3ef437d97dd0",
        "runtime:ab1ee1bf7691ec3b",
        "runtime:b6cd7c54b4b62831",
        "runtime:fb46ac117ec9d307"
      ],
      "upstreamResult": "React uses synthetic input changes, forwardRef wrappers, SSR strings and an invisible suspended owner without an additional committed notification.",
      "octaneResult": "Native input events and ref props preserve the same DOM assertions. SSR assertions read RenderResult.html and normalize only hydration boundary comments. The first held transition restores the committed owner to publish its cue; this accepted render produces one unchanged-state notification, while suspended state never reaches base atoms or subscribers.",
      "rationale": "These adaptations follow Octane’s documented native events, ref/SSR APIs and pending-cue commit behavior. The immutable React suites keep all original assertions. Native tests retain exact visible state, base state, notification values, markup and mounted-input identity.",
      "classification": "renderer-contract",
      "consumerImpact": "Use onInput for per-keystroke text edits and refs as props. Raw store observers may receive the unchanged committed snapshot during a held transition; they never observe the suspended controlled value.",
      "migrationGuidance": "Read server result .html, use native input events/ref props, and compare selected store values instead of relying on React-specific commit counts.",
      "owner": "@octanejs/tanstack-table",
      "reviewCondition": "Review when upstream tests or Octane’s input, ref, SSR or transition commit contracts change."
    }
  ],
  "materializedTests": "packages/tanstack-table"
