{
  "name": "@octanejs/tanstack-db",
  "version": "0.0.13",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "TanStack DB bindings for Octane — reuses @tanstack/db's framework-agnostic core with Octane live-query hooks.",
  "author": "Kyle Mathews",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/tanstack-db"
  },
  "homepage": "https://tanstack.com/db",
  "keywords": [
    "optimistic",
    "octane",
    "typescript",
    "tanstack-intent"
  ],
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE.upstream"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/db": "^0.7.0"
  },
  "peerDependencies": {
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "octane": "workspace:*",
    "vitest": "catalog:default"
  }
}
