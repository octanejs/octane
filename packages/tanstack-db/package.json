{
  "name": "@octanejs/tanstack-db",
  "version": "0.0.15",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "TanStack DB bindings for Octane \u2014 reuses @tanstack/db's framework-agnostic core with Octane live-query hooks.",
  "author": "Kyle Mathews",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/tanstack-db"
  },
  "homepage": "https://tanstack.com/db",
  "keywords": [
    "optimistic",
    "octane",
    "typescript",
    "tanstack-intent"
  ],
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE.upstream",
    "LICENSE",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run --root ../.. --project tanstack-db --project tanstack-db-differential --project tanstack-db-hydration --project tanstack-db-portal",
    "upstream:check": "node ../../scripts/react-parity/verify-provenance.mjs --package-dir ."
  },
  "dependencies": {
    "@tanstack/db": "0.9.0"
  },
  "peerDependencies": {
    "octane": "workspace:^0.1.51 || ^0.2.0"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "octane": "workspace:*",
    "vitest": "catalog:default",
    "@tanstack/react-db": "0.3.8",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "catalog:default",
    "@types/react": "catalog:default",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "@tsrx/react": "catalog:default",
    "esbuild": "catalog:default",
    "@types/react-dom": "catalog:default"
  }
}
