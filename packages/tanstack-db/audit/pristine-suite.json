{
  "schemaVersion": 1,
  "project": "tanstack-db-pristine",
  "vitestConfig": "tests/upstream-vitest.config.ts",
  "rootEnvVar": "TANSTACK_DB_PRISTINE_ROOT",
  "copy": ["src", "tests"],
  "inlineFiles": {
    "package.json": {
      "type": "module"
    },
    "tsconfig.json": {
      "compilerOptions": {
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2020"
      }
    }
  }
}
