{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": false,
    "types": [],
    "allowImportingTsExtensions": true
  },
  "include": ["./published.test-d.ts", "./consumer.pristine.tsx"],
  "reactPortEvidence": {
    "gate": "upstream-types-pristine",
    "upstreamRegistrations": [],
    "publicMode": "pinned"
  }
}
