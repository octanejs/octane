{
  "name": "@octanejs/react-error-boundary",
  "version": "0.1.33",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "react-error-boundary for Octane, adapted onto Octane's native error boundary.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/react-error-boundary"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "LICENSE.upstream",
    "UPSTREAM.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.tsrx"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "scripts": {
    "test": "pnpm upstream:verify && vitest run --root ../.. --project react-error-boundary --project react-error-boundary-ssr --project react-error-boundary-differential && node ../../scripts/react-parity/harness.mjs run-required --manifest packages/react-error-boundary/audit/react-parity.json",
    "upstream:verify": "node ../../scripts/react-parity/verify-provenance.mjs"
  },
  "peerDependencies": {
    "octane": "workspace:^0.1.51 || ^0.2.0"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/jest-dom": "catalog:default",
    "@testing-library/react": "16.3.2",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "@tsrx/react": "catalog:default",
    "esbuild": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "react-error-boundary": "6.1.5",
    "vitest": "catalog:default",
    "vitest-fail-on-console": "0.10.1"
  }
}
