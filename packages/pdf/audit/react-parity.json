      "id": "pdf-octane-node-ref-event-types",
      "caseIds": ["differential:react-pdf-document-shells"],
      "upstreamResult": "React's public declarations use ReactNode, React ref types, synthetic event types, and React CSS property types.",
      "octaneResult": "The binding declares OctaneNode, refs-as-props, native DOM events, and Octane class/style values.",
      "rationale": "Octane deliberately exposes native event and ref-prop contracts instead of React's synthetic and forwardRef-oriented types.",
      "classification": "intentional-framework-divergence",
      "consumerImpact": "Type-only React node, ref, event, and CSS annotations need Octane equivalents when migrating an application.",
      "migrationGuidance": "Use OctaneNode, plain ref props, native event types, and Octane-supported class/style values.",
      "owner": "@octanejs/pdf",
      "reviewCondition": "Revisit if Octane adopts a compatibility type layer without changing native runtime semantics."
    },
