  "divergences": [
    {
      "id": "native-mouseenter",
      "caseIds": ["runtime:881f043dd890fb2b", "conformance:hot-toast-native-pause"],
      "upstreamResult": "React synthesizes the Toaster container's onMouseEnter/onMouseLeave from mouseover/mouseout, so a mouseenter fired on a toast reaches the container's pause handler.",
      "octaneResult": "The pause handlers are the native, non-bubbling mouseenter/mouseleave listeners on the container, which a pointer entering any toast dispatches there.",
      "rationale": "Octane delivers native DOM events and has no synthetic enter/leave layer.",
      "classification": "event-model",
      "consumerImpact": "None for real pointers. Tests that fire mouseenter on a toast element must fire it on the Toaster container instead.",
      "migrationGuidance": "Dispatch mouseenter/mouseleave on the [data-rht-toaster] container in tests.",
      "owner": "@octanejs/hot-toast",
      "reviewCondition": "Review if Octane adds synthetic enter/leave delegation."
    },
    {
      "id": "goober-pragma",
      "caseIds": ["conformance:hot-toast-goober-pragma"],
      "upstreamResult": "react-hot-toast calls goober's setup(React.createElement) when it loads, replacing any pragma the application configured.",
      "octaneResult": "The port renders its own elements and never calls setup(), so the application's goober pragma stays in place.",
      "rationale": "goober's styled() builds React elements through its global pragma; the port authors those elements in .tsrx and uses goober only to compile CSS.",
      "classification": "framework-integration",
      "consumerImpact": "Applications that also use goober keep their own pragma regardless of import order.",
      "migrationGuidance": "No change needed.",
      "owner": "@octanejs/hot-toast",
      "reviewCondition": "Review if upstream stops calling setup() at module load."
    },
    {
      "id": "shared-headless-store",
      "caseIds": ["conformance:hot-toast-shared-headless-store"],
      "upstreamResult": "The root and /headless entries are separate bundles, each with its own toast store.",
      "octaneResult": "Both entries publish the same source modules and therefore share one toast store.",
      "rationale": "Octane bindings ship their authored source unbundled, so both entries resolve the same modules.",
      "classification": "implementation",
      "consumerImpact": "A toast created through one entry also reaches toasters and useToaster hooks imported from the other.",
      "migrationGuidance": "No change needed; mixing the entries now behaves as one store.",
      "owner": "@octanejs/hot-toast",
      "reviewCondition": "Review if the binding starts bundling its entries."
    }
  ]
