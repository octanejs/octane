{
  "name": "@octanejs/animejs",
  "version": "0.0.22",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./src/adapters/three.ts"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "Anime.js bindings for Octane with scoped lifecycle cleanup and Three.js adapter support.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/animejs"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "UPSTREAM.md",
    "status.json",
    "LICENSE.upstream"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./adapters/three": "./src/adapters/three.ts",
    "./timer": "./src/timer.ts",
    "./animation": "./src/animation.ts",
    "./timeline": "./src/timeline.ts",
    "./animatable": "./src/animatable.ts",
    "./draggable": "./src/draggable.ts",
    "./scope": "./src/scope.ts",
    "./engine": "./src/engine.ts",
    "./events": "./src/events.ts",
    "./layout": "./src/layout.ts",
    "./easings": "./src/easings.ts",
    "./easings/eases": "./src/easings/eases.ts",
    "./easings/linear": "./src/easings/linear.ts",
    "./easings/steps": "./src/easings/steps.ts",
    "./easings/irregular": "./src/easings/irregular.ts",
    "./easings/cubic-bezier": "./src/easings/cubic-bezier.ts",
    "./easings/spring": "./src/easings/spring.ts",
    "./utils": "./src/utils.ts",
    "./svg": "./src/svg.ts",
    "./text": "./src/text.ts",
    "./waapi": "./src/waapi.ts",
    "./adapters": "./src/adapters.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --root ../.. --config vitest.config.js --project animejs --project animejs-ssr",
    "typecheck": "tsrx-tsc --noEmit"
  },
  "dependencies": {
    "animejs": "catalog:default"
  },
  "peerDependencies": {
    "@types/three": ">=0.156.0",
    "octane": "workspace:^0.1.51 || ^0.2.0",
    "three": ">=0.156.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@octanejs/three": "workspace:*",
    "@types/three": "catalog:default",
    "octane": "workspace:*",
    "three": "catalog:default",
    "vitest": "catalog:default"
  }
}
