{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "jsx": "react-jsx",
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "strict": true,
    "paths": {
      "@tanstack/react-pacer": ["../../upstream/src/index.ts"]
    }
  },
  "include": ["../../upstream/src/**/*.ts", "../../upstream/src/**/*.tsx", "./*.ts"],
  "reactPortEvidence": {
    "gate": "upstream-types-pristine",
    "upstreamRegistrations": [],
    "publicMode": "pinned"
  }
}
