{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "strict": true,
    "types": ["node"],
    "paths": {
      "@octanejs/tanstack-pacer": ["../../src/index.ts"],
      "@octanejs/tanstack-pacer/*": ["../../src/*/index.ts"],
      "@octanejs/tanstack-store": ["../../../tanstack-store/src/index.ts"],
      "octane": ["../../../octane/src/index.ts"],
      "react": ["../../node_modules/@types/react"],
      "react/*": ["../../node_modules/@types/react/*"]
    }
  },
  "include": ["../../src/**/*.ts", "../../src/**/*.tsrx", "./*.ts"],
  "reactPortEvidence": {
    "gate": "upstream-types-adapted",
    "upstreamRegistrations": [],
    "publicMode": "pinned"
  }
}
