{
  "name": "@octanejs/next-themes",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "next-themes for Octane — a port of the ThemeProvider, useTheme hook and no-flash theme script, with or without Next.js.",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/next-themes"
  },
  "main": "src/index.tsrx",
  "module": "src/index.tsrx",
  "types": "src/index.tsrx",
  "sideEffects": false,
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE",
    "LICENSE.upstream"
  ],
  "exports": {
    ".": "./src/index.tsrx"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project next-themes --project next-themes-pristine --project next-themes-adapted --project next-themes-differential --project next-themes-ssr",
    "typecheck": "octane-tsc -p tsconfig.json",
    "upstream:verify": "node ../../scripts/react-parity/verify-provenance.mjs",
    "upstream:test": "node ../../scripts/react-parity/run-pristine.mjs next-themes"
  },
  "peerDependencies": {
    "octane": "workspace:^0.16.0"
  },
  "devDependencies": {
    "@octanejs/testing-library": "workspace:*",
    "@testing-library/react": "catalog:default",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vitest": "catalog:default"
  }
}
