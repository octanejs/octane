{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "jsx": "preserve",
    "jsxImportSource": "octane",
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests/**/*.ts", "tests/**/*.tsrx"],
  "exclude": ["tests/browser", "tests/differential", "tests/package", "upstream"]
}
