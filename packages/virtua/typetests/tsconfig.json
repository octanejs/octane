{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "jsx": "preserve",
    "jsxImportSource": "octane",
    "noEmit": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@octanejs/virtua": ["../src/index.ts"]
    }
  },
  "include": ["*.ts", "*.tsrx"]
}
