{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": false,
    "noEmit": true,
    "noErrorTruncation": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "octane": ["../../octane/src/index.ts"],
      "octane/*": ["../../octane/src/*"]
    }
  },
  "include": ["./**/*.test-d.ts", "../src/types.ts"]
}
