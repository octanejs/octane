{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node"],
    "noEmit": true,
    "noErrorTruncation": true,
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "tests/_fixtures"]
}
