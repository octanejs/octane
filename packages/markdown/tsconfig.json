{
  "tsrx": {
    "compiler": "octane/compiler"
  },
  "compilerOptions": {
    "module": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "target": "esnext",
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "noEmit": true,
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noErrorTruncation": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "strict": true
  },
  "include": ["src", "tests/**/*.tsrx"],
  "exclude": ["node_modules", "dist", "upstream", "typetests", "audit/type-probes"]
}
