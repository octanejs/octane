{
  "name": "@octanejs/blocknote",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN UPSTREAM.md",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "description": "An Octane adapter for @blocknote/core editors (private pending provenance review).",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/blocknote"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project blocknote --project blocknote-ssr",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json",
    "typecheck:public": "tsrx-tsc --noEmit -p tests/types/tsconfig.json"
  },
  "dependencies": {
    "@blocknote/core": "catalog:default"
  },
  "peerDependencies": {
    "octane": "workspace:^0.5.0"
  },
  "devDependencies": {
    "octane": "workspace:*",
    "vitest": "catalog:default"
  }
}
