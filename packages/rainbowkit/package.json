{
  "name": "@octanejs/rainbowkit",
  "version": "0.0.30",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "octane": {
    "hookSlots": {
      "manual": [
        "src"
      ]
    }
  },
  "description": "Octane-native RainbowKit connection UI contracts over @octanejs/wagmi v3.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/rainbowkit"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "status.json"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "test": "vitest run --root ../.. --project rainbowkit --project rainbowkit-ssr"
  },
  "dependencies": {
    "@octanejs/wagmi": "workspace:*",
    "@wagmi/core": "catalog:default"
  },
  "peerDependencies": {
    "@octanejs/tanstack-query": "workspace:*",
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@rainbow-me/rainbowkit": "2.2.11",
    "@octanejs/tanstack-query": "workspace:*",
    "@testing-library/jest-dom": "catalog:default",
    "@tsrx/react": "catalog:default",
    "@wagmi/connectors": "catalog:default",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "viem": "catalog:default",
    "vitest": "catalog:default"
  }
}
