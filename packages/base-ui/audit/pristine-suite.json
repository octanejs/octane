{
  "schemaVersion": 1,
  "project": "base-ui-pristine",
  "vitestConfig": "tests/vitest.pristine.config.ts",
  "rootEnvVar": "BASE_UI_PRISTINE_ROOT",
  "copy": ["src", "test"],
  "inlineFiles": {
    "tsconfig.json": {
      "compilerOptions": {
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2020"
      }
    }
  }
}
