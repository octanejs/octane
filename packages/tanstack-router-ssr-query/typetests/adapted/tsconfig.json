{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": false,
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "jsxImportSource": "octane"
  },
  "include": ["./integration.test-d.ts"],
  "reactPortEvidence": {
    "gate": "upstream-types-adapted",
    "publicMode": "pinned",
    "upstreamRegistrations": []
  },
  "tsrx": {
    "compiler": "octane/compiler/volar"
  }
}
