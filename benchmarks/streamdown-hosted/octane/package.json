{
  "name": "octane-streamdown-hosted-bench",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite --host --port 5301 --strictPort",
    "build": "pnpm --filter octane build && pnpm --filter @octanejs/streamdown build && vite build",
    "preview": "vite preview --port 5301 --strictPort"
  },
  "dependencies": {
    "@octanejs/streamdown": "workspace:*",
    "katex": "^0.16.27",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "catalog:default",
    "terser": "catalog:default",
    "vite": "catalog:default"
  }
}
