{
  "include": ["octane-jsx/src/**/*.tsx", "octane-tsrx/src/**/*.tsrx"],
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2024",
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "plugins": [
      {
        "name": "@tsrx/typescript-plugin"
      }
    ]
  }
}
