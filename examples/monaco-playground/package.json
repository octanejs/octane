{
  "name": "monaco-playground-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monaco Editor playground built on octane via @octanejs/monaco-editor — Vite worker recipe + Editor/DiffEditor journeys.",
  "scripts": {
    "dev": "vite --host --port 5215 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host --port 5215 --strictPort",
    "typecheck": "tsrx-tsc --noEmit -p tsconfig.json",
    "test:e2e": "pnpm build && OCTANE_EXAMPLE_PREVIEW=1 playwright test --config e2e/playwright.config.ts",
    "test:e2e:dev": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@octanejs/monaco-editor": "workspace:*",
    "monaco-editor": "catalog:default",
    "octane": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:default",
    "@types/node": "catalog:default",
    "typescript": "catalog:default",
    "vite": "catalog:default"
  }
}
