    "@octanejs/livestore": "workspace:*",
    "@octanejs/lucide": "workspace:*",
    "@octanejs/mantine-hooks": "workspace:*",
    "@octanejs/mobx": "workspace:*",
    "@octanejs/phosphor-icons": "workspace:*",
    "@octanejs/radix": "workspace:*",
    "@octanejs/spring": "workspace:*",
    "@octanejs/rainbowkit": "workspace:*",
    "@octanejs/solana-kit": "workspace:*",
    "@octanejs/react-error-boundary": "workspace:*",
    "@octanejs/resizable-panels": "workspace:*",
    "@octanejs/dropzone": "workspace:*",
    "@octanejs/markdown": "workspace:*",
