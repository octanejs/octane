{
  "name": "octane-playground",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "description": "Playground for octane — the template-clone renderer, compiled through octane/compiler.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "debug-all": "node ../../scripts/debug-mode.js all octane/compiler",
    "debug-client": "node ../../scripts/debug-mode.js client octane/compiler",
    "debug-ssr": "node ../../scripts/debug-mode.js server octane/compiler",
    "debug-volar": "node ../../scripts/debug-mode.js tsx octane/compiler",
    "debug-tsx": "pnpm run debug-volar"
  },
  "dependencies": {
    "@octanejs/cmdk": "workspace:*",
    "@octanejs/lucide": "workspace:*",
    "@octanejs/mantine-hooks": "workspace:*",
    "@octanejs/mobx": "workspace:*",
    "@octanejs/phosphor-icons": "workspace:*",
    "@octanejs/radix": "workspace:*",
    "@octanejs/rainbowkit": "workspace:*",
    "@octanejs/react-error-boundary": "workspace:*",
    "@octanejs/rxjs": "workspace:*",
    "@octanejs/sonner": "workspace:*",
    "@octanejs/tanstack-query": "workspace:*",
    "@octanejs/wagmi": "workspace:*",
    "@wagmi/connectors": "catalog:default",
    "@octanejs/usehooks-ts": "workspace:*",
    "class-variance-authority": "catalog:default",
    "clsx": "catalog:default",
    "octane": "workspace:*",
    "rxjs": "catalog:default",
    "tailwind-merge": "catalog:default"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:default",
    "shadcn": "catalog:default",
    "tailwindcss": "catalog:default",
    "tw-animate-css": "catalog:default",
    "typescript": "catalog:default",
    "vite": "catalog:default"
  }
}
