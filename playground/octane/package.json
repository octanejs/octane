{
  "name": "octane-playground",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "description": "Playground for octane — the template-clone renderer, compiled through octane/compiler.",
  "scripts": {
    "dev": "vite --configLoader runner --host",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host",
    "debug-all": "node ../../scripts/debug-mode.js all octane/compiler",
    "debug-client": "node ../../scripts/debug-mode.js client octane/compiler",
    "debug-ssr": "node ../../scripts/debug-mode.js server octane/compiler",
    "debug-volar": "node ../../scripts/debug-mode.js tsx octane/compiler",
    "debug-tsx": "pnpm run debug-volar"
  },
  "dependencies": {
    "@livestore/adapter-web": "catalog:default",
    "@livestore/common": "catalog:default",
    "@livestore/livestore": "catalog:default",
    "@livestore/utils": "catalog:default",
    "@octanejs/alien-signals": "workspace:*",
    "@opentelemetry/api": "catalog:default",
    "@octanejs/animejs": "workspace:*",
    "@octanejs/aria": "workspace:*",
    "@octanejs/cmdk": "workspace:*",
    "@octanejs/drei": "workspace:*",
    "@octanejs/formisch": "workspace:*",
    "@octanejs/gsap": "workspace:*",
